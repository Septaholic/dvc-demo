          <div class="key">
            * Lưu &yacute;: 
          </div> 
          <table class="table-data" style="width:100%;"> 
           <thead> 
            <tr> 
             <th style="width:65%;">T&ecirc;n giấy tờ</th> 
             <th style="width:15%;">Mẫu đơn, tờ khai</th> 
