            var htmlText = '';
            result.forEach(item => {

                htmlText += item.REQUIRE_NAME;
            });
            $(".cls-requires").html(htmlText);
        
        } else {
            $(".cls-requires").html("Không có thông tin");
        }
    }

    function loadRelatedProcedures() {

        var obj = new Object();
        obj.service = "procedure_get_related_procedures_service_v2";
