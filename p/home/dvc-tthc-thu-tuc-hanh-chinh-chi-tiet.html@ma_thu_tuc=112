                    toastr.error('Thực hiện không thành công.');
                }
            },
            error: function (error) {
                toastr.error('Thực hiện không thành công.');
            }
        });
    }

    function extractAgencyCode(input) {
        //V1V2V3.Z1Z2.Y1Y2.MX1X2-YYMMDD-XXXX
        if (input !== "") {
            var str = input.split("-");
            return str[0];
        }

        return "";
