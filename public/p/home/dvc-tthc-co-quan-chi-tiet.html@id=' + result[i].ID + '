            if (lan_load_trang == 1)
                $('#hide_if_have_data').show();
        }
    });

    function loadCoCauToChuc() {
        var obj = new Object();
        obj.service = "get_co_cau_to_chuc_v3";
        obj.provider = "dvcquocgia";
        obj.type = "ref";
        obj.id = agencyId;

        var result = apiservice.AjaxJson.executeQuery(obj);

        var html = '';
        if (result.length == 0) {
            $('#hide_if_empty').show();
            $('#coCauToChuc').hide();
        } else {
            $('#hide_if_empty').hide();
            $('#coCauToChuc').show();
            var isLvl2Show = false;
            var isLvl1Show = false;

            for (var i = 0; i < result.length; i++) {
                var item = result[i];
                var nextItem = ((i + 1) < result.length) ? result[i + 1] : '';

                if (item.LVL == 1) {
                    if (item.ISLEAF == 0) {
                        isLvl1Show = true;
                        html += '<li><span class="li-toggle icon -ap icon-square-plus">' + '</span><a href="dvc-tthc-co-quan-chi-tiet.html?id=' + item.ID + '">' + validStr(item.NAME) + '</a>';
                        html += '<ul class="nested">';
                    } else {
                        html += '<li><a href="dvc-tthc-co-quan-chi-tiet.html?id=' + item.ID + '">' + validStr(item.NAME) + "</a></li>";
                    }
                } else {
                    if (item.LVL == 2) {
                        if (item.ISLEAF == 0) {
                            isLvl2Show = true;

                            html += '<li><span class="li-toggle icon -ap icon-square-plus">' + '</span><a href="dvc-tthc-co-quan-chi-tiet.html?id=' + item.ID + '">' + validStr(item.NAME) + '</a>';
                            html += '<ul class="nested">';
                        } else {
                            html += '<li><a href="dvc-tthc-co-quan-chi-tiet.html?id=' + item.ID + '">' + validStr(item.NAME) + "</a></li>";
                        }
                    } else {
                        html += '<li><a href="dvc-tthc-co-quan-chi-tiet.html?id=' + item.ID + '">' + validStr(item.NAME) + "</a></li>";
                    }

                    if ((nextItem.LVL == 2 && isLvl2Show) || (nextItem.LVL == 1 && isLvl1Show)) {
                        isLvl2Show = false;
                        html += '</ul>';
                        html += "</li>";
                    }
                }

                if (nextItem.LVL == 1 && isLvl1Show) {
                    isLvl1Show = false;
                    html += '</ul>';
                    html += "</li>";
                }
            }

            $('#coCauToChuc').html(html);
            var toggler = document.getElementsByClassName("li-toggle");
            var index;

            for (index = 0; index < toggler.length; index++) {
                toggler[index].addEventListener("click", function () {
                    this.parentElement.querySelector(".nested").classList.toggle("active");
                    this.classList.toggle("icon-square-minus");
                });
            }
        }
    }

    function loadCoCauToChucV2() {
        var obj = new Object();
        obj.service = "get_co_quan_by_cha_id";
        obj.provider = "dvcquocgia";
        obj.type = "ref";
        obj.id = agencyId;

        var result = apiservice.AjaxJson.executeQuery(obj);
        console.log(result);
        var html = '';
        if (result.length == 0) {
            $('#hide_if_empty').show();
            $('#coCauToChuc').hide();
        } else {
            $('#hide_if_empty').hide();
            $('#coCauToChuc').show();

            for (var i = 0; i < result.length; i++) {
                var item = result[i];
                if (item.AGENCY_JSON != undefined && item.AGENCY_JSON != "") {
                    html += '<li><span class="li-toggle icon -ap icon-square-plus">' + '</span><a href="dvc-tthc-co-quan-chi-tiet.html?id=' + item.ID + '">' + validStr(item.NAME) + '</a>';
                    html += '<ul class="nested">';

                    var agencyJson2 = JSON.parse(item.AGENCY_JSON);
                    for (var j = 0; j < agencyJson2.length; j++) {
                        var item2 = agencyJson2[j];

                        if (item2.AGENCY_JSON != undefined && item2.AGENCY_JSON != "") {
                            html += '<li><span class="li-toggle icon -ap icon-square-plus">' + '</span><a href="dvc-tthc-co-quan-chi-tiet.html?id=' + item2.ID + '">' + validStr(item2.NAME) + '</a>';
                            html += '<ul class="nested">';

                            var agencyJson3 = item2.AGENCY_JSON;
                            for (var k = 0; k < agencyJson3.length; k++) {
                                var item3 = agencyJson3[k];
                                if (item3.AGENCY_JSON != undefined && item3.AGENCY_JSON != "") {
                                    html += '<li><span class="li-toggle icon -ap icon-square-plus">' + '</span><a href="dvc-tthc-co-quan-chi-tiet.html?id=' + item3.ID + '">' + validStr(item3.NAME) + '</a>';
