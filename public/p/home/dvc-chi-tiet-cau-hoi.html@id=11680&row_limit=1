function sugggestProcedure(keyword) {
    var obj = new Object();
    obj.key_search = 'al:"' + keyword +'"~5';
    obj.page_size = 5;
    obj.start_row = 0;
    obj.source_data = "thu_tuc_v1";
    obj.type = "fts";
    var result = apiservice.AjaxJson.executeQuery(obj);
    var dataMap = result.response.docs.map(function (i) {
        return {
            name: i.ten_thu_tuc,
            link: i.ten_thu_tuc,
            id: i.ma_thu_tuc
        }
    });

    return dataMap;
}

