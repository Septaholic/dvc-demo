---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Chi tiết thủ tục hành chính - Cổng Dịch vụ công Quốc gia" activeNav="tthc">
  <div class="container" style="padding-top: 30px; padding-bottom: 50px;">
    <!-- Breadcrumb -->
    <ul class="breadcrumb" style="background: transparent; padding: 0 0 15px 0;">
      <li><a href="/"><i class="fa fa-home"></i> Trang chủ</a></li>
      <li><a href="/p/home/dvc-tthc-thu-tuc-hanh-chinh.html">Thủ tục hành chính</a></li>
      <li class="active" id="proc-breadcrumb">Chi tiết thủ tục</li>
    </ul>

    <div class="row">
      <div class="col-sm-8 col-xs-12">
        <h1 id="proc-title" class="main-title -none" style="font-size: 24px; font-weight: 800; color: #0b5796; margin-bottom: 12px; line-height: 1.3;">
          Đang tải thông tin thủ tục hành chính...
        </h1>

        <div style="margin-bottom: 20px;" id="proc-badges">
          <span class="badge" id="badge-code" style="background-color: #0b5796; color: white; padding: 6px 12px; font-size: 13px; margin-right: 8px;">Mã thủ tục: ---</span>
          <span class="badge" id="badge-level" style="background-color: #2e7d32; color: white; padding: 6px 12px; font-size: 13px; margin-right: 8px;">Cấp Tỉnh / Trung ương</span>
          <span class="badge" style="background-color: #ef6c00; color: white; padding: 6px 12px; font-size: 13px;">Dịch vụ công trực tuyến</span>
        </div>

        <div class="box-action-bar" style="background: #f8fafc; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 4px solid #0b5796; border-top: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
          <p style="margin-bottom: 8px; font-size: 14px;"><strong>Cơ quan thực hiện:</strong> <span id="proc-agency">Đang cập nhật...</span></p>
          <p style="margin-bottom: 8px; font-size: 14px;"><strong>Lĩnh vực:</strong> <span id="proc-field">Đang cập nhật...</span></p>
          <p style="margin-bottom: 15px; font-size: 14px;"><strong>Cách thức thực hiện:</strong> Nộp trực tuyến qua Cổng Dịch vụ công hoặc trực tiếp tại Bộ phận Một cửa.</p>
          <a href="javascript:void(0)" onclick="$('#modalNopHoSo').modal('show')" class="btn btn-main" style="background: #0b5796; color: #fff; padding: 10px 24px; font-size: 15px; font-weight: bold; border-radius: 6px; text-transform: uppercase;">
            <i class="fa fa-send" style="margin-right: 6px;"></i> Nộp hồ sơ trực tuyến
          </a>
        </div>

        <div class="divider-gray" style="height: 1px; background: #e2e8f0; margin: 25px 0;"></div>

        <h2 class="main-title-sub" style="font-size: 18px; font-weight: 700; color: #0b5796; margin-bottom: 15px;">
          <i class="fa fa-list-ol" style="margin-right: 8px;"></i>Trình tự thực hiện
        </h2>
        <div class="list-expand" style="margin-bottom: 25px;">
          <div class="item active" style="padding: 18px; background: #fff; border: 1px solid #e2e8f0; border-radius: 6px;">
            <div class="content" id="proc-steps" style="line-height: 1.6; font-size: 14px;">
              <p><strong>Bước 1:</strong> Cá nhân, tổ chức chuẩn bị đầy đủ hồ sơ theo quy định và nộp trực tuyến qua Cổng DVC hoặc tại Bộ phận Một cửa.</p>
              <p><strong>Bước 2:</strong> Cơ quan có thẩm quyền tiếp nhận hồ sơ, kiểm tra tính hợp lệ và cấp giấy tiếp nhận hồ sơ cùng giấy hẹn trả kết quả.</p>
              <p><strong>Bước 3:</strong> Tiến hành thẩm định hồ sơ, kiểm tra thực tế (nếu có yêu cầu).</p>
              <p><strong>Bước 4:</strong> Trả kết quả giải quyết thủ tục hành chính cho cá nhân, tổ chức theo phiếu hẹn.</p>
            </div>
          </div>
        </div>

        <h2 class="main-title-sub" style="font-size: 18px; font-weight: 700; color: #0b5796; margin-bottom: 15px;">
          <i class="fa fa-folder-open-o" style="margin-right: 8px;"></i>Thành phần hồ sơ
        </h2>
        <div class="box-content-tthc" style="padding: 18px; background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; margin-bottom: 25px;">
          <ul id="proc-dossier" style="margin-bottom: 0; padding-left: 20px; line-height: 1.8; font-size: 14px;">
            <li>Đơn/Tờ khai theo mẫu quy định của cơ quan quản lý nhà nước.</li>
            <li>Bản sao có chứng thực các giấy tờ, văn bằng, chứng chỉ hoặc tài liệu chứng minh có liên quan.</li>
            <li>Giấy tờ tùy thân (Căn cước công dân / Hộ chiếu) của người thực hiện thủ tục.</li>
            <li>Văn bản ủy quyền hợp pháp (trong trường hợp thực hiện qua người đại diện).</li>
          </ul>
        </div>

        <h2 class="main-title-sub" style="font-size: 18px; font-weight: 700; color: #0b5796; margin-bottom: 15px;">
          <i class="fa fa-money" style="margin-right: 8px;"></i>Phí, lệ phí
        </h2>
        <div class="box-content-tthc" style="padding: 18px; background: #fff; border: 1px solid #e2e8f0; border-radius: 6px; margin-bottom: 25px; font-size: 14px;">
          <p id="proc-fee" style="margin: 0;">Theo quy định của Bộ Tài chính và Hội đồng nhân dân cấp tỉnh tương ứng với từng loại thủ tục.</p>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="col-sm-4 col-xs-12">
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin-bottom: 25px;">
          <h3 style="font-size: 16px; font-weight: 700; color: #0b5796; margin: 0 0 15px 0; border-bottom: 2px solid #e2e8f0; padding-bottom: 10px;">
            <i class="fa fa-university" style="margin-right: 6px;"></i>Chọn cơ quan thực hiện
          </h3>
          <div class="form-group">
            <label style="font-size: 13px; color: #475569;">Tỉnh / Thành phố:</label>
            <select class="form-control" id="cboTINH_THANH_TTHC">
              <option value="1">Thành phố Hà Nội</option>
              <option value="2">Thành phố Hồ Chí Minh</option>
              <option value="3">Thành phố Đà Nẵng</option>
              <option value="4">Thành phố Hải Phòng</option>
              <option value="5">Thành phố Cần Thơ</option>
            </select>
          </div>
          <div class="form-group">
            <label style="font-size: 13px; color: #475569;">Cấp thực hiện:</label>
            <select class="form-control" id="cboCAP_THUC_HIEN">
              <option value="tinh">Cấp Tỉnh (Sở/Ban/Ngành)</option>
              <option value="huyen">Cấp Huyện (UBND Quận/Huyện)</option>
              <option value="xa">Cấp Xã (UBND Phường/Xã)</option>
            </select>
          </div>
          <button class="btn btn-main w100" style="background: #0b5796; color: #fff; width: 100%; font-weight: 600; padding: 10px;" onclick="toastr.success('Đã tải thông tin địa phương áp dụng dịch vụ công!')">
            Đồng ý
          </button>
        </div>

        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 18px;">
          <h4 style="font-size: 15px; font-weight: 700; color: #1e40af; margin: 0 0 10px 0;">
            <i class="fa fa-info-circle"></i> Trợ giúp thực hiện
          </h4>
          <p style="font-size: 13px; color: #1e3a8a; margin-bottom: 12px; line-height: 1.5;">
            Nếu gặp khó khăn trong quá trình kê khai hoặc nộp hồ sơ, quý khách vui lòng liên hệ tổng đài hỗ trợ <strong>1800 1096</strong>.
          </p>
          <a href="/p/home/dvc-cau-hoi-pho-bien.html" class="btn btn-sm btn-default" style="width: 100%; font-weight: 600;">
            Xem câu hỏi thường gặp
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal Nop Ho So Truc Tuyen (MockDB) -->
  <div class="modal fade" id="modalNopHoSo" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
      <div class="modal-content" style="border-radius: 8px;">
        <div class="modal-header" style="background: #0b5796; color: white; border-radius: 8px 8px 0 0;">
          <button type="button" class="close" data-dismiss="modal" style="color: white; opacity: 0.9;">&times;</button>
          <h4 class="modal-title" style="font-weight: 700;"><i class="fa fa-send"></i> Kê khai nộp hồ sơ trực tuyến</h4>
        </div>
        <div class="modal-body" style="padding: 20px;">
          <div id="submit-form-container">
            <div class="alert alert-info" style="font-size: 13px; margin-bottom: 15px;">
              <i class="fa fa-info-circle"></i> Hệ thống đang chạy ở chế độ <strong>Mô phỏng cơ sở dữ liệu (Client-side MockDB)</strong>. Dữ liệu nộp hồ sơ sẽ được lưu trữ cục bộ trên trình duyệt để tra cứu tiến độ ngay lập tức.
            </div>
            <div class="form-group">
              <label>Thủ tục hành chính:</label>
              <input type="text" class="form-control" id="form-proc-name" readonly />
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group">
                  <label>Họ và tên người nộp <span class="text-danger">*</span>:</label>
                  <input type="text" class="form-control" id="form-applicant-name" placeholder="Ví dụ: Nguyễn Văn An" value="Nguyễn Văn An" required />
                </div>
              </div>
              <div class="col-sm-6">
                <div class="form-group">
                  <label>Số CCCD / Định danh <span class="text-danger">*</span>:</label>
                  <input type="text" class="form-control" id="form-cccd" placeholder="Ví dụ: 001090012345" value="001090012345" required />
                </div>
              </div>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group">
                  <label>Số điện thoại liên hệ <span class="text-danger">*</span>:</label>
                  <input type="text" class="form-control" id="form-phone" placeholder="Ví dụ: 0912345678" value="0912345678" required />
                </div>
              </div>
              <div class="col-sm-6">
                <div class="form-group">
                  <label>Địa chỉ liên hệ:</label>
                  <input type="text" class="form-control" id="form-address" placeholder="Ví dụ: Hà Nội" value="Phường Tràng Tiền, Hoàn Kiếm, Hà Nội" />
                </div>
              </div>
            </div>
            <div class="form-group">
              <label>Ghi chú / Tệp đính kèm mô phỏng:</label>
              <textarea class="form-control" id="form-note" rows="2" placeholder="Ghi chú hồ sơ hoặc danh sách tệp giấy tờ...">Hồ sơ đã chuẩn bị đầy đủ bản chụp scan theo quy định.</textarea>
            </div>
          </div>

          <div id="submit-success-container" style="display: none; text-align: center; padding: 20px 10px;">
            <div style="width: 60px; height: 60px; background: #dcfce7; color: #16a34a; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 28px; margin-bottom: 15px;">
              <i class="fa fa-check"></i>
            </div>
            <h3 style="color: #166534; font-weight: 700; margin-top: 0;">Nộp hồ sơ thành công!</h3>
            <p style="color: #4b5563; font-size: 14px;">Hồ sơ của bạn đã được ghi nhận vào cơ sở dữ liệu mô phỏng của hệ thống.</p>
            <div style="background: #f1f5f9; border-radius: 8px; padding: 15px; margin: 15px 0;">
              <span style="font-size: 13px; color: #64748b;">MÃ HỒ SƠ TRA CỨU:</span>
              <div id="generated-dossier-code" style="font-size: 24px; font-weight: 800; color: #0b5796; letter-spacing: 1px;">DVC-2026-0000</div>
            </div>
            <div style="display: flex; gap: 10px; justify-content: center; margin-top: 15px;">
              <a href="/p/home/dvc-tra-cuu-ho-so.html" class="btn btn-primary" style="font-weight: 600;">
                <i class="fa fa-search"></i> Đến trang Tra cứu hồ sơ
              </a>
              <button type="button" class="btn btn-default" data-dismiss="modal">Đóng</button>
            </div>
          </div>
        </div>
        <div class="modal-footer" id="modal-submit-footer">
          <button type="button" class="btn btn-default" data-dismiss="modal">Hủy bỏ</button>
          <button type="button" class="btn btn-primary" id="btnConfirmSubmit" style="background: #0b5796; font-weight: 600;">
            <i class="fa fa-check"></i> Xác nhận gửi hồ sơ
          </button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      var currentProc = null;
      var urlParams = new URLSearchParams(window.location.search);
      var code = urlParams.get('ma_thu_tuc');
      if (!code) return;

      var procs = window.OFFLINE_PROCEDURES || [];
      for (var i = 0; i < procs.length; i++) {
        if (procs[i].PROCEDURE_CODE === code) {
          currentProc = procs[i];
          break;
        }
      }

      if (currentProc) {
        document.title = currentProc.PROCEDURE_NAME + ' - Cổng DVCQG';
        var elTitle = document.getElementById('proc-title');
        if (elTitle) elTitle.innerText = currentProc.PROCEDURE_NAME;
        var elBadge = document.getElementById('badge-code');
        if (elBadge) elBadge.innerText = 'Mã thủ tục: ' + currentProc.PROCEDURE_CODE;
        var elAgency = document.getElementById('proc-agency');
        if (elAgency) elAgency.innerText = currentProc.IMPLEMENTATION_AGENCY || currentProc.PUBLISHED_AGENCY || 'Cơ quan có thẩm quyền';
        var elField = document.getElementById('proc-field');
        if (elField) elField.innerText = currentProc.FIELD_NAME || 'Thủ tục hành chính';
        $('#form-proc-name').val(currentProc.PROCEDURE_NAME + ' (' + currentProc.PROCEDURE_CODE + ')');
      }

      $('#btnConfirmSubmit').on('click', function() {
        var name = $('#form-applicant-name').val();
        var cccd = $('#form-cccd').val();
        var phone = $('#form-phone').val();
        var address = $('#form-address').val();
        var note = $('#form-note').val();

        if (!name || !cccd || !phone) {
          if (window.toastr) toastr.error('Vui lòng nhập đầy đủ các trường bắt buộc (*)');
          else alert('Vui lòng nhập đầy đủ các trường bắt buộc (*)');
          return;
        }

        var newRecord = window.MockDB ? window.MockDB.dossiers.create({
          procedureCode: currentProc ? currentProc.PROCEDURE_CODE : '1.000000',
          procedureName: currentProc ? currentProc.PROCEDURE_NAME : 'Thủ tục hành chính trực tuyến',
          applicantName: name,
          cccd: cccd,
          phone: phone,
          address: address,
          note: note,
          agency: currentProc ? (currentProc.IMPLEMENTATION_AGENCY || currentProc.PUBLISHED_AGENCY) : 'Cơ quan có thẩm quyền'
        }) : { code: 'DVC-2026-9999' };

        $('#generated-dossier-code').text(newRecord.code);
        $('#submit-form-container').hide();
        $('#modal-submit-footer').hide();
        $('#submit-success-container').show();
        if (window.toastr) toastr.success('Đã ghi nhận hồ sơ vào cơ sở dữ liệu mô phỏng!');
      });

      $('#modalNopHoSo').on('hidden.bs.modal', function () {
        $('#submit-form-container').show();
        $('#modal-submit-footer').show();
        $('#submit-success-container').hide();
      });
    })();
  </script>
</Layout>
