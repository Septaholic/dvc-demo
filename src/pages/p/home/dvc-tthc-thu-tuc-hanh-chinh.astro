		function loadListImplLevel() {
            var htmlText = `<option value="-1">-- Chọn cấp thực hiện --</option>
                            <option value="1">-- Cấp Tỉnh --</option>
                            
                            <option value="3">-- Cấp Xã --</option>`;
    
            $("#select-level").html(htmlText);
