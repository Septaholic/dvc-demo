    desc: "Thông báo hoạt động khuyến mại, lưu thông hàng hóa, quản lý xuất nhập khẩu và xúc tiến thương mại.",
    events: [
      { id: "291", name: "Thông báo, đăng ký hoạt động khuyến mại" },
      { id: "293", name: "Lưu thông hàng hóa trong nước" },
      { id: "294", name: "Thủ tục hải quan và kiểm tra chuyên ngành" },
      { id: "292", name: "Quản lý cạnh tranh và xúc tiến thương mại" }
    ]
  },
  {
    id: "765",
    name: "Sở hữu trí tuệ, đăng ký tài sản",
    icon: "/p/home/theme/img/doanhnghiep/icons-white/sohuutritue.svg",
    desc: "Đăng ký bảo hộ nhãn hiệu, logo, chỉ dẫn địa lý, kiểu dáng công nghiệp và chuyển giao công nghệ.",
    events: [
      { id: "297", name: "Đăng ký bảo hộ nhãn hiệu, logo thương hiệu" },
      { id: "298", name: "Đăng ký sở hữu công nghiệp và bản quyền" },
      { id: "300", name: "Đăng ký cấp bằng sáng chế, giải pháp hữu ích" },
      { id: "299", name: "Chuyển giao công nghệ" }
    ]
  },
  {
    id: "762",
    name: "Tài chính doanh nghiệp",
    icon: "/p/home/theme/img/doanhnghiep/icons-white/taichinh.svg",
    desc: "Thủ tục kê khai thuế, phát hành hoá đơn điện tử và tiếp cận nguồn vốn ưu đãi.",
    events: [
      { id: "278", name: "Thuế và hóa đơn điện tử" },
