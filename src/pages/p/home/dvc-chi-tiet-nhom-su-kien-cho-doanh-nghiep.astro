    desc: "Hợp nhất, sáp nhập, chia tách và chuyển đổi loại hình doanh nghiệp.",
    events: [
      { id: "307", name: "Chuyển đổi loại hình doanh nghiệp" },
      { id: "306", name: "Hợp nhất, sáp nhập doanh nghiệp" },
      { id: "308", name: "Chia tách doanh nghiệp" }
    ]
  },
  {
    id: "769",
    name: "Tạm dừng, chấm dứt hoạt động",
    icon: "/p/home/theme/img/doanhnghiep/icons-white/tamdung.svg",
