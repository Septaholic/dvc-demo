  },
  {
    id: "791",
    name: "Giải quyết tranh chấp hợp đồng",
    icon: "/p/home/theme/img/doanhnghiep/icons-white/tranhchap.svg",
    desc: "Thủ tục trọng tài thương mại và giải quyết tranh chấp kinh doanh.",
    events: [
      { id: "344", name: "Giải quyết tranh chấp hợp đồng thương mại" }
    ]
  }
];
---

<Layout title="Sự kiện đời thường dành cho Doanh nghiệp - Cổng Dịch vụ công Quốc gia">
  <div class="section-doanh-nghiep" style="background:#f4f6f9; min-height:800px; padding: 25px 0 50px 0;">
    <div class="container">
      <!-- Breadcrumb -->
      <ul class="breadcrumb" style="background:transparent; padding: 8px 0; margin-bottom: 20px;">
        <li><a href="/" style="color:#1e40af; font-weight:600;"><i class="fa fa-home"></i> Trang chủ</a></li>
        <li><a href="/#doanh-nghiep">Dành cho doanh nghiệp</a></li>
        <li class="active">Nhóm sự kiện đời thường</li>
      </ul>

      <!-- Page Header -->
      <div style="background: linear-gradient(135deg, #0d3b66 0%, #1e40af 100%); color:white; border-radius:12px; padding: 25px 30px; margin-bottom: 30px; box-shadow: 0 4px 15px rgba(13,59,102,0.25);">
        <div class="row" style="align-items: center; display: flex; flex-wrap: wrap;">
          <div class="col-md-8">
            <span style="display:inline-block; background:rgba(255,255,255,0.2); padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 10px;">
              <i class="fa fa-building-o"></i> Cổng Dịch vụ công Quốc gia dành cho Doanh nghiệp
            </span>
            <h1 id="group-main-title" style="margin: 0 0 10px 0; font-size: 26px; font-weight: 700; color: #fff;">
              Khởi sự kinh doanh
            </h1>
            <p id="group-main-desc" style="margin: 0; font-size: 15px; opacity: 0.95; line-height: 1.6;">
              Cung cấp thủ tục cấp giấy phép an ninh trật tự, an toàn thực phẩm, bảo hộ nhãn hiệu và thành lập doanh nghiệp, tổ chức kinh doanh.
            </p>
          </div>
          <div class="col-md-4 text-right" style="margin-top: 15px;">
            <a href="/p/home/dvc-tthc-thu-tuc-hanh-chinh" class="btn btn-warning btn-lg" style="font-weight: 700; border-radius: 8px; box-shadow: 0 3px 10px rgba(0,0,0,0.15);">
              <i class="fa fa-search"></i> Tra cứu tất cả TTHC
            </a>
          </div>
        </div>
      </div>

      <!-- Main Layout: Sidebar of Groups + Event Accordions -->
      <div class="row">
        <!-- Left Column: Groups List -->
        <div class="col-md-4 col-sm-5">
          <div class="panel panel-default" style="border-radius: 10px; overflow: hidden; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
            <div class="panel-heading" style="background:#fff; border-bottom: 2px solid #1e40af; padding: 15px 20px;">
              <h4 style="margin:0; font-size: 16px; font-weight: 700; color: #1e293b;">
                <i class="fa fa-briefcase" style="color:#1e40af; margin-right:8px;"></i> Các nhóm sự kiện doanh nghiệp
              </h4>
            </div>
            <div class="list-group" id="groups-list" style="margin-bottom:0;">
              {businessGroups.map((g) => (
                <a
                  href={`#group=${g.id}`}
                  class="list-group-item group-tab-btn"
                  data-group-id={g.id}
                  style="padding: 14px 20px; font-size: 14px; font-weight: 600; color: #334155; border-left: 4px solid transparent; transition: all 0.2s;"
                >
                  <span class="fa fa-chevron-right pull-right" style="font-size: 11px; margin-top: 4px; color: #94a3b8;"></span>
                  {g.name}
                </a>
              ))}
            </div>
          </div>

          <!-- Quick Help Box -->
          <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; padding: 20px; margin-top: 20px;">
            <h5 style="color: #1e40af; font-weight: 700; margin-top: 0;">
              <i class="fa fa-info-circle"></i> Trợ giúp doanh nghiệp
            </h5>
            <p style="font-size: 13px; color: #3b82f6; margin-bottom: 12px; line-height: 1.5;">
              Hỗ trợ thực hiện thủ tục hành chính công và thanh toán nghĩa vụ thuế doanh nghiệp 24/7.
            </p>
            <div style="font-size: 18px; font-weight: 800; color: #1e40af;">
              <i class="fa fa-phone"></i> 1800 1096
            </div>
          </div>
        </div>

        <!-- Right Column: Events & Procedures -->
        <div class="col-md-8 col-sm-7">
          <div style="background: white; border-radius: 10px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(0,0,0,0.04); padding: 25px;">
            <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 20px;">
              <div>
                <h3 id="current-group-heading" style="margin: 0; font-size: 18px; font-weight: 700; color: #0f172a;">
                  Khởi sự kinh doanh
                </h3>
                <small style="color: #64748b;">Nhấp vào từng sự kiện bên dưới để xem chi tiết thủ tục hành chính liên quan</small>
              </div>
            </div>

            <!-- Dynamic Accordion Container -->
            <div class="panel-group" id="events-accordion" role="tablist" aria-multiselectable="true">
              <!-- Rendered via JS based on selected group -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ businessGroups }}>
    window.BUSINESS_GROUPS_DATA = businessGroups;

    function getParam(name) {
      var match = RegExp('[?&]' + name + '=([^&]*)').exec(window.location.search);
      if (!match) {
        match = RegExp('#.*group=([^&]*)').exec(window.location.hash);
      }
      return match ? decodeURIComponent(match[1].replace(/\+/g, ' ')) : null;
    }

    function renderGroup(groupId) {
      var group = window.BUSINESS_GROUPS_DATA.find(function(g) { return g.id === groupId; });
      if (!group) {
        group = window.BUSINESS_GROUPS_DATA[0];
      }

      // Update UI title & desc
      $('#group-main-title').text(group.name);
      $('#group-main-desc').text(group.desc);
      $('#current-group-heading').text(group.name);

      // Highlight active in sidebar
      $('.group-tab-btn').removeClass('active').css({
        'border-left-color': 'transparent',
        'background-color': 'white',
        'color': '#334155'
      });
      $('.group-tab-btn[data-group-id="' + group.id + '"]').addClass('active').css({
        'border-left-color': '#1e40af',
        'background-color': '#eff6ff',
        'color': '#1e40af'
      });

      // Render Accordion for events
      var html = '';
      group.events.forEach(function(ev, idx) {
        var isFirst = idx === 0;
        var collapseId = 'collapseEvent_' + ev.id;
        html += `
          <div class="panel panel-default" style="border: 1px solid #e2e8f0; margin-bottom: 12px; border-radius: 8px; overflow: hidden;">
            <div class="panel-heading" role="tab" style="background: #f8fafc; padding: 14px 18px; cursor: pointer;" onclick="loadEventProcedures('${ev.id}')">
              <h4 class="panel-title" style="font-size: 15px; font-weight: 700; color: #1e293b;">
                <a role="button" data-toggle="collapse" data-parent="#events-accordion" href="#${collapseId}" aria-expanded="${isFirst ? 'true' : 'false'}" style="text-decoration:none; display:flex; justify-content:space-between; align-items:center;">
                  <span><i class="fa fa-briefcase" style="color:#1e40af; margin-right: 10px;"></i> ${ev.name}</span>
                  <span class="fa fa-chevron-down" style="font-size: 12px; color: #64748b;"></span>
                </a>
              </h4>
            </div>
            <div id="${collapseId}" class="panel-collapse collapse ${isFirst ? 'in' : ''}" role="tabpanel">
              <div class="panel-body" style="padding: 15px 20px; background: white;">
                <div id="event_container_${ev.id}">
                  <div style="text-align:center; padding: 20px; color:#94a3b8;">
                    <i class="fa fa-spinner fa-spin"></i> Đang tải danh sách thủ tục...
                  </div>
                </div>
              </div>
            </div>
          </div>
        `;
      });

      $('#events-accordion').html(html);

      // Automatically load first event's procedures
      if (group.events.length > 0) {
        loadEventProcedures(group.events[0].id);
      }
    }

    function loadEventProcedures(eventId) {
      var container = $('#event_container_' + eventId);

      var obj = {
        service: "dvcqg_gets_procedure_by_event_id_limit_v2",
        type: "ref",
        limit: 10,
        event_id: eventId
      };

      var list = [];
      if (window.apiservice && window.apiservice.AjaxJson) {
        list = window.apiservice.AjaxJson.executeQuery(obj) || [];
      } else if (window.TARGET_SERVICES_BY_EVENT && window.TARGET_SERVICES_BY_EVENT[eventId]) {
        list = window.TARGET_SERVICES_BY_EVENT[eventId];
      }

      if (list && list.length > 0) {
        var listHtml = '<ul style="list-style: none; padding-left: 0; margin-bottom: 0;">';
        list.forEach(function(item) {
          var code = item.PROCEDURE_CODE;
          var link = '/p/home/dvc-chi-tiet-thu-tuc-hanh-chinh?ma_thu_tuc=' + encodeURIComponent(code);
          
          listHtml += `
            <li style="padding: 12px 14px; border-bottom: 1px dashed #e2e8f0; display: flex; justify-content: space-between; align-items: center; transition: background 0.15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
              <div style="padding-right: 15px;">
                <a href="${link}" style="font-weight: 600; color: #1e40af; font-size: 14px; text-decoration: none; line-height: 1.4; display: block;">
                  <i class="fa fa-file-text-o" style="color: #64748b; margin-right: 6px;"></i> ${item.PROCEDURE_NAME}
                </a>
                <span style="font-size: 12px; color: #64748b; margin-top: 4px; display: inline-block;">
                  Mã TTHC: <strong style="color: #334155;">${code}</strong>
                </span>
              </div>
              <div style="white-space: nowrap;">
                <a href="${link}" class="btn btn-primary btn-sm" style="font-weight: 600; border-radius: 4px; padding: 4px 10px;">
                  Xem thủ tục <i class="fa fa-angle-right"></i>
                </a>
              </div>
            </li>
          `;
        });
        listHtml += '</ul>';
        container.html(listHtml);
      } else {
        container.html(`
          <div style="padding: 15px; color: #64748b; font-size: 13px; text-align: center;">
            <i class="fa fa-info-circle"></i> Chưa có thủ tục trực tuyến mẫu cho sự kiện này hoặc đang cập nhật.
          </div>
        `);
      }
    }

    $(document).ready(function() {
      var requestedGroup = getParam('group') || '760';
      renderGroup(requestedGroup);

      $('.group-tab-btn').on('click', function(e) {
        e.preventDefault();
        var gid = $(this).data('group-id');
        history.pushState(null, null, '?group=' + gid);
        renderGroup(gid);
      });
    });
  </script>
</Layout>
