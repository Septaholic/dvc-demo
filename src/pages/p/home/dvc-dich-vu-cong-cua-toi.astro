            <option value="0">-- Chọn trạng thái hồ sơ --</option> 
            <option value="1">Mới đăng ký </option> 
            <option value="2">Được tiếp nhận </option> 
            <option value="3">Không được tiếp nhận </option> 
            <option value="4">Đang xử lý </option> 
            <option value="5">Yêu cầu bổ sung giấy tờ </option> 
            <option value="6">Yêu cầu thực hiện nghĩa vụ tài chính </option> 
            <option value="7">Công dân yêu cầu rút hồ sơ </option> 
            <option value="8">Dừng xử lý </option> 
            <option value="9">Đã xử lý xong </option> 
            <option value="10">Đã trả kết quả</option> 
            <option value="11">BNĐP từ chối</option> 
            <option value="13">Đã nộp tại CDVCQG (chưa gửi tới BNĐP)</option> 
            <option value="14">Không gửi được</option> 
           </select> 
          </div> 
