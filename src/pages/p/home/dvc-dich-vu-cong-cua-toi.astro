        </div> 
       </div> 
       <div class="center"> 
        <button class="btn btn-main" onclick="searchSubmission()">Tìm kiếm</button> 
       </div> 
      </div> 
      <div class="divider-gray"></div> 
      <div class="mydvc-list"> 
       <div id="dichVuCong"> 
        <div class="text"><div class="center" style="font-size:18px;color: rgb(206, 122, 88);margin-top: 30px;">Không tìm thấy hồ sơ nào thoả mãn điều kiện tìm kiếm</div></div>
       </div> 
       <table class="table-dvc" id="tableListDVC"> 
       </table> 
      </div> 
     </div> 
     <ul class="pagination pull-right" id="paginationCN" style="padding-bottom: 40px;"> 
