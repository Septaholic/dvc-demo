  <script is:inline>
    var PAGE_SIZE = 10;
    var submissionId;
    var submissionCodePA = "";
    var orgName = "";

    function doSearch(currentPage) {
        var keyword = $.trim($('#tenDVC').val());
        var maHS = $.trim($('#maHS').val());
        var status = $('#trangThaiSearch').val();

        $('#tableListDVC').html('');
        $('#dichVuCong').html('<div class="text"><div class="center" style="font-size:18px;color: rgb(206, 122, 88);margin-top: 30px;">Không tìm thấy hồ sơ nào thoả mãn điều kiện tìm kiếm</div></div>');
        $('#dichVuCong').show();
        if (typeof loadPagination === 'function') {
            loadPagination(0, 0, "paginationCN", "doChangePageCN", null, PAGE_SIZE);
        }
    }

    function searchSubmission() {
        var text = $.trim($('#tenDVC').val());
        $('#tenDVC').val(text);
        getTotalSubmissionByUser();
        doSearch(1);
    }

    function getTotalSubmissionByUser() {
        $('#finishNumber').text('0');
        $('#processingNumber').text('0');
    }

    function doChangePageCN(currentPage) {
        doSearch(currentPage);
    }

    $(document).ready(function () {
        if ($.fn.select2) {
            $('#trangThaiSearch').select2({
                width: "100%",
            });
        }

        doSearch(1);
        getTotalSubmissionByUser();

        $('#tenDVC:text:visible:first').focus();

        // Update username if available
        var rawUser = sessionStorage.getItem('dvc_user');
        if (rawUser) {
            try {
                var u = JSON.parse(rawUser);
                if (u.name) {
                    $('.dvc-user-name').text(u.name);
                }
            } catch(e) {}
        }
    });
  </script>

