  <script is:inline>
    var maHSSelected = "";
    var tthcSelected = "";

    function bindEventHomeee() {
        getLocation("dvcqg_get_tinh_thanh_by_selected_tra_cuu_v2", null, null, "cboTINH_THANHTT");
        getLocation("dvcqg_get_quan_huyen_by_selected_tra_cuu_v2", "tinh_id", -1, "cboQUAN_HUYENTT");
        getLocation("dvcqg_get_phuong_xa_by_selected_tra_cuu_v2", "huyen_id", -1, "cboPHUONG_XATT");

        $("#cboTINH_THANHTT,#cboQUAN_HUYENTT,#cboPHUONG_XATT").select2({
            allowClear: true,
            width: "100%",
        });

        $("#cboTINH_THANHTT").change(function () {
            getLocation("dvcqg_get_quan_huyen_by_selected_tra_cuu_v2", "tinh_id", $("#cboTINH_THANHTT").val(), "cboQUAN_HUYENTT");
            // getLocation("dvcqg_get_phuong_xa_by_selected_tra_cuu_v2", "huyen_id", -1, "cboPHUONG_XATT");
        });

        // $("#cboQUAN_HUYENTT").change(function () {
        //     getLocation("dvcqg_get_phuong_xa_by_selected_tra_cuu_v2", "huyen_id", $("#cboQUAN_HUYENTT").val(), "cboPHUONG_XATT");
        // });
    }

    function checkThongTinTT(submissionCode, procedureCode, TaiKhoanDongBo) {
        maHSSelected = submissionCode;
        tthcSelected = procedureCode;
        var data = new Object();
        data.submissionCode = submissionCode;
        data.captCha = $("#ipCaptchaB").val();
        data.backend = "false";
        showLoading();

        $.ajax({
            type: 'POST',
            url: '/jsp/submission-bill/tracuu-hoso.jsp',
            data: data,
            success: function (response) {
                if (response.error_code > 0) {
                    hideLoading();
                    fillDataToModalTT(response.error_code, response.message, TaiKhoanDongBo);
                } else {
                    if (response.error_code  == -1 || response.error_code  == -2) {
                        toastr.warning('Vui lòng tra cứu lại để thực hiện kiểm tra thông tin thanh toán!');
                        $('#ipCaptchaB').focus()
                        changeCaptcha();
                        hideLoading();
                        return;
                    }
                    hideLoading();
                }
                 
            },
            error: function (error) {
                hideLoading();
                toastr.warning('Không thể tra cứu thông tin thanh toán mã hồ sơ này tại địa phương');
            }
        });
    }

    function getUserInfo() {
        $("#hoTenNTT").val("");
        $("#soCMNDNTT").val("");
        var obj = new Object();
        obj.service = 'get_user_info_full';
        obj.type = "qry";
        obj.technical_id = '';

        var result = apiservice.AjaxJson.executeQuery(obj);

        if (result && result.length > 0 && JSON.stringify(result) != "[null]" && result[0].ERROR_CODE != "") {
            var fullInfoStr = result[0].FULL_INFO_EXTRA;

            if (fullInfoStr) {
                var obj = JSON.parse(fullInfoStr);
                var diaChiHT = obj.DiaChi;

                if (diaChiHT) {
                    var diaChiHTObj = JSON.parse(diaChiHT.value);
                    
                    if (Object.keys(diaChiHTObj).length > 0) {
                        var tinhId = diaChiHTObj.TinhID;
                        var huyenId = diaChiHTObj.HuyenID;
                        var xaId = diaChiHTObj.XaID;
                        var soNha = diaChiHTObj.SoNha;
            
                        if (tinhId && tinhId != '-1') {
                            $("#cboTINH_THANHTT").val(tinhId).trigger('change');
                            getLocation("dvcqg_get_quan_huyen_by_selected_tra_cuu_v2", "tinh_id", tinhId, "cboQUAN_HUYENTT");
                        } else {
                            getLocation("dvcqg_get_quan_huyen_by_selected_tra_cuu_v2", "tinh_id", -1, "cboQUAN_HUYENTT");
                        }
            
                        if (huyenId && huyenId != '-1') {
                            $("#cboQUAN_HUYENTT").val(huyenId).trigger('change');
                            getLocation("dvcqg_get_phuong_xa_by_selected_tra_cuu_v2", "huyen_id", huyenId, "cboPHUONG_XATT");
                        } else {
                            getLocation("dvcqg_get_phuong_xa_by_selected_tra_cuu_v2", "huyen_id", -1, "cboPHUONG_XATT");
                        }
            
                        if (xaId && xaId != '-1') {
                            $("#cboPHUONG_XATT").val(xaId).trigger('change');
                        }
            
                        if (soNha) {
                            $("#cboSONHATT").val(soNha);
                        }
                    }
                }
            }
        }
    }

    $('#btnThongTinTT').on('click', function () {
        $("#fmThongTinTTTT").data('bootstrapValidator').validate();
        
        if ($("#fmThongTinTTTT").has('.has-error').length <= 0) {   
            var ttObj = new Object();
            ttObj.HoTen = $("#hoTenNTT").val();
            ttObj.TaiKhoanDongBo = $("#TaiKhoanDongBo").val();
            ttObj.SoCMND = $("#soCMNDNTT").val();
            ttObj.TinhThanh = $("#cboTINH_THANHTT option:selected").text();
            // ttObj.QuanHuyen = $("#cboQUAN_HUYENTT option:selected").text();
            ttObj.XaPhuong = $("#cboQUAN_HUYENTT option:selected").text();
            ttObj.DiaChi = $("#cboSONHATT").val() + ', ' + ttObj.XaPhuong + ', ' + ttObj.TinhThanh ;

            var data = new Object();
            data.MaHoSo = maHSSelected;
            data.ThongTinNguoiNop = JSON.stringify(ttObj);

            $.ajax({
                type: 'POST',
                url: '/jsp/submission-bill/thanhtoan-hoso.jsp',
                data: data,
                success: function (rsPay) {
                    if (rsPay && rsPay.error_code === '0') {
                        if (rsPay.url)
                            window.open(rsPay.url, "_self");
                        else 
                            toastr.warning('Lỗi kết quả thanh toán.');
                    } else {
                        toastr.warning(rsPay.message);
                    }
                },
                error: function (error) {
                    toastr.warning('Không thể tra cứu thông tin thanh toán mã hồ sơ này tại địa phương');
                }
            });
        }
    });

    $("#soCMNDNTT").focus(function () {
        $('#fmThongTinTTTT').data('bootstrapValidator').updateStatus('soCMNDNTT', 'NOT_VALIDATED');
    });

    function fillDataToModalTT(error_code, data, TaiKhoanDongBo) {
        if(data) {
            //var data = response[0];
            $("#tbSoTien").html("");
            $("#btnActionTT").html("");
            $("#ttTT #maHoSoTT .value").text(maHSSelected);
            var tenDVC = data.TenDVC ? data.TenDVC : getTenDVCByTTHC(tthcSelected);
            $("#ttTT #tenDVC .value").text(tenDVC);
            
            var ttText = error_code == 1 ? "Yêu cầu thanh toán phí, lệ phí DVC" : "Không có phí cần thanh toán";
            $("#ttTT #ttHoSO .value").text(ttText);
            var btnStr = "";
            var tbStr = "";
            if(error_code == 1) {
                $("#tbTTTT").show();
                btnStr += '<button class="btn btn-main" data-toggle="modal" data-target="#thongTinTT">Tiếp tục thanh toán</button>';
            } else {
                $("#tbTTTT").hide();
                btnStr += '<button class="btn btn-second" data-dismiss="modal">Bỏ qua</button>';
            }
            
            if(error_code == 1) {
                for(i = 0; i < data.PhiLePhi.length; i++) {
                    var obj = data.PhiLePhi[i];
                    var soTien = obj.SoTien;
                    tbStr += "<tr>";
                    tbStr += '<td data-title="Loại phí">' + obj.TenPhiLePhi + '</td>';
                    tbStr += '<td data-title="Số tiền" id="soTien">' + format_curency(soTien) + '</td>';
                }
    
                $("#tbSoTien").html(tbStr);
                $("#TaiKhoanDongBo").val(TaiKhoanDongBo);
            }
            $("#btnActionTT").html(btnStr);
            $('#ttTT').modal("show");
        } else {
            toastr.warning("Không thể kết nối tới BNĐP để lấy thông tin thanh toán");
        }
    }

    function getTenDVCByTTHC(procedureCode) {
        var obj = new Object();
        obj.service = 'get_dvc_name_by_tthc';
        obj.type = "ref";
        obj.procedure_code = procedureCode;

        var result = apiservice.AjaxJson.executeQuery(obj);

        if (result && result.length > 0 && JSON.stringify(result) != "[null]" && result[0].ERROR_CODE != "") {
            return result[0].TENDVC;
        }

        return "";
    }

    function format_curency(number) {
        return number.replace(/(\d)(?=(\d{3})+(?!\d))/g, "$1,") + " VNĐ";
    }

    (function ($) {
        $("#handy-menu").addClass("active");
        $.fn.bootstrapValidator.validators.validatorCMND = {
            html5Attributes: {
                message: 'message',
                field: 'field'
            },

            validate: function (validator, $field, options) {
                var cValue = $('#soCMNDNTT').val();
                var value = cValue.replace(/\s/g, '');
                var isNumberic = Math.floor(value) == value && $.isNumeric(value);

                if( cValue == value ) {
                    if(value.length == 0) {
                        return {
                            valid: false, 
                            message: 'Nhập số CMND/CCCD người nộp tiền'
                        };
                    }
    
                    if ((value.length != 9 && value.length != 10 && value.length != 12) || !isNumberic) {
                        return {
                            valid: false, 
                            message: 'Số CMND/CCCD không đúng định dạng'
                        };
                    }

                    return true;
                } else {
                    return {
                        valid: false, 
                        message: 'Số CMND/CCCD không đúng định dạng'
                    };
                }
            }
        }

        $.fn.bootstrapValidator.validators.validatorSelect = {
            html5Attributes: {
                message: 'message',
                field: 'field'
            },

            validate: function (validator, $field, options) {
                var id = '#' + options.field;
                if ($(id).val() == null || $(id).val() == -1) {
                    return false;
                }
            }
        }
    }(window.jQuery));

    function resetFormTT() {
        $("#hoTenNTT").val("");
        $("#soCMNDNTT").val("");
        $("#cboSONHATT").val("");
        bindEventHomeee();
    }

    $(document).ready(function () {
        bindEventHomeee();
        $("#ttTT").on("hidden.bs.modal", function () {
            $("#ttTT #maHoSoTT .value").text();
            $("#ttTT #tenDVC .value").text();
            $("#ttTT #ttHoSO .value").text();
            $(".modal-backdrop.in").hide();
            resetFormTT();
        });

        $("#thongTinTT").on("shown.bs.modal", function () {  
            getUserInfo();
        });

        $("#thongTinTT").on("hidden.bs.modal", function () {
            maHSSelected = "";
            tthcSelected = "";
            $('#fmThongTinTTTT').data('bootstrapValidator').resetForm(true);
            resetFormTT();
        });

        $('#fmThongTinTTTT').bootstrapValidator({
            feedbackIcons: {
                valid: 'glyphicon glyphicon-ok',
                validating: 'glyphicon glyphicon-refresh'
            },
            excluded: [':disabled'],
            fields: {
                hoTenNTT: {
                    validators: {
                        notEmpty: {
                            message: 'Nhập họ tên người nộp tiền'
                        },
                    }
                },
                soCMNDNTT: {
                    validators: {
                        validatorCMND : {
                            field: 'soCMNDNTT',
                            message: 'Số CMND/CCCD không đúng định dạng'
                        }
                    }
                },
                tinh_thanhtt: {
                    validators: {
                        validatorSelect: {
                            field: 'cboTINH_THANHTT',
                            message: 'Chọn tỉnh thành'
                        },
                    }
                },
                quan_huyentt: {
                    validators: {
                        validatorSelect: {
                            field: 'cboQUAN_HUYENTT',
                            message: 'Chọn phường xã'
                        },
                    }
                },
                // phuong_xatt: {
                //     validators: {
                //         validatorSelect: {
                //             field: 'cboPHUONG_XATT',
                //             message: 'Chọn phường xã'
                //         },
                //     }
                // },
                cboSONHATT: {
                    validators: {
                        notEmpty: {
                            message: 'Nhập thông tin chi tiết địa chỉ'
                        },
                    }
                },
            }

        });
    })
    
</script> 
