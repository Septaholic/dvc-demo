    function getFmListPomotion() {
        var obj = new Object();
        obj.service = 'promotion_get_merchant_paging';
        obj.type = "ref";
        obj.keyword = '';
        obj.page_index = 1;
        obj.provider = "dvcquocgiaRead";

        var result = apiservice.AjaxJson.executeQuery(obj);

        if (result && result.length > 0 && JSON.stringify(result) != "[null]" && result[0].ERROR_CODE != "") {
            var objData = [];
            objData.push({ ID: "-1", NAME: "-- Tất cả --" });
            objData = objData.concat(result);
            select2Promotion($('#cboSEARCH_PRO_TECHNICAL_ID'), objData);
        } else {
            select2Promotion($('#cboSEARCH_PRO_TECHNICAL_ID'), []);
        }
    }

    function select2Promotion(element, initValue) {
        var initials = [];
        if (initValue !== undefined) {
            $.each(initValue, function (index, value) {
                initials.push({ id: value.ID, text: value.NAME });
            });
        }

        $(element).select2({
            data: initials,
            allowClear: true,
            width: 'element',
            ajax: {
                url: '/jsp/rest.jsp',
                dataType: 'json',
                delay: 250,
                type: 'POST',
                async: false,
                data: function (params) {
                    var objJson = new Object();
                    var jsonData = {
                        service: 'promotion_get_merchant_paging',
                        type: 'ref',
                        provider: 'dvcquocgiaRead',
                        keyword: params && params.term ? params.term + '' : '',
                        page_index: params.page || 1 + ''
                    };

                    objJson.params = JSON.stringify(jsonData);

                    return objJson;
                },
                processResults: function (data, params) {
                    var objData = [];
                    params.page = params.page || 1;
                    if (params.page == 1) {
                        objData.push({ ID: "-1", NAME: "-- Tất cả --" });
                    }

                    objData = objData.concat(data);

                    return {
                        results: $.map(objData, function (d) {
                            d.text = d.NAME;
                            d.id = d.ID;
                            return d;
                        }),
                        pagination: {
                            more: (params.page * 30) < (data[0] && data[0].TOTAL_RECORD ? data[0].TOTAL_RECORD : 0)
                        }
                    };
                }
            }
        });

        if (initValue !== undefined) {
            var listId = initValue.map(function (item) {
                return item.ID;
            });
            $(element).val(listId).trigger('change');
        }
    }

