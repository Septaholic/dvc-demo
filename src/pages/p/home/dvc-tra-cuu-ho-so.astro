    function renderDetailHTML(result) {
        var tblBody = "";

        for (i = 0; i < result.length; i++) {
            var data = result[i];

            tblBody += '<tr>';
            tblBody += '<td>' + validStr(data.NoiDungXuLy) + '</td>';
            if (data.PhongBanXuLy) {
                tblBody += '<td>' + data.PhongBanXuLy + '</td>';
            } else {
                tblBody += '<td>Không có thông tin</td>';
            }

            if (data.NguoiXuLy) {
                tblBody += '<td>' + data.NguoiXuLy + '</td>';
            } else {
                tblBody += '<td>Không có thông tin</td>';
            }

            tblBody += '<td>' + getDateFromString(data.NgayBatDau) + '</td>';

            if (data.NgayKetThucTheoQuyDinh) {
                tblBody += '<td>' + getDateFromString(data.NgayKetThucTheoQuyDinh) + '</td>';
            } else {
                tblBody += '<td>Không có thông tin</td>';
            }

            tblBody += '</tr>';
        }

        $('#processTableBody').html(tblBody);
    }

