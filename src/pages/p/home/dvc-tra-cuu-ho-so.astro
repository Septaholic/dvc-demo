    var PROMOTION_DEFAULT_PAGE_SIZE = 6;
    function doSearchPromotion(currentPage, isFirstLoad) {

        $('#traCuuPromotionEmpty').hide();
        let divHtml = '';
        let spanCount = 'trên 0 bản ghi';
        let PROMOTION_PAGE_SIZE = Number($('#cboCHANGE_PROMOTION_PAGE_SIZE').val()) || PROMOTION_DEFAULT_PAGE_SIZE;
        let objSearch = {
            type: 'ref',
            service: 'promotion_tien_ich_tra_cuu_v2',
            SUBMISSION_CODE: $('#txtSEARCH_PRO_CODE').val().trim() || '-1',
            MERCHANT_ID: $('#cboSEARCH_PRO_TECHNICAL_ID').val() || '-1',
            CITY_ID: $('#cboSEARCH_PRO_CITY_ID').val() || '-1',
            page_index: currentPage,
            record_per_page: PROMOTION_PAGE_SIZE,
            provider: 'dvcquocgiaRead',
        };
        let searchResult = apiservice.AjaxJson.executeQuery(objSearch);
        //console.log("searchResult: ", searchResult);
        if (searchResult && searchResult.length > 0) {
            for (let e of searchResult) {

                let submissionCode = e.SUBMISSION_CODE;
                let agencyId = e.AGENCY_ID;

                divHtml += '<div class="item">';
                divHtml += '<div class="wrap">';
                divHtml += '<div class="icon"><img src="img/tbkm/km.svg" alt=""></div>';
                divHtml += '<a style="cursor:pointer" class="title" onClick="showDetailPromotion(\'' + submissionCode + '\',\'' + agencyId + '\')">' + e.PROMOTION_NAME + '</a>';
                divHtml += '<a class="post-location" data-toggle="tooltip" title="' + e.MERCHANT_NAME + '">' + e.MERCHANT_NAME + '</a>';
                divHtml += '<div class="post-date">Từ ngày: ' + moment(e.DATE_FROM).format('DD/MM/YYYY') + '</div>';
                divHtml += '<div class="post-date">Đến ngày: ' + moment(e.DATE_TO).format('DD/MM/YYYY') + '</div>';
                divHtml += '</div></div>';
            }
            let totalCount = Number(searchResult[0].TOTAL);
            spanCount = 'trên ' + totalCount + ' bản ghi';
            $('#divPromotionPagination').show();
            loadPagination(totalCount, currentPage, "paginationSearchPromotion", "doChangePageTableSearchPromotion", [], PROMOTION_PAGE_SIZE);
        } else {

            loadPagination(0, currentPage, "paginationSearchPromotion", "doChangePageTableSearchPromotion", [], PROMOTION_PAGE_SIZE);
            if (!isFirstLoad) {

                $('#traCuuPromotionEmpty').html('<div class="text"><div class="title center" style="font-size: 18px;color: #545151;padding-top:20px">Không tìm thấy hồ sơ nào thoả mãn điều kiện tìm kiếm</div></div>');
                $('#traCuuPromotionEmpty').show();
            }
            $('#divPromotionPagination').hide();
        }

        $('#divLIST_PROMOTION').html(divHtml);
        $('#spanTOTALCOUNT').html(spanCount);
        $(function () {
            $('[data-toggle="tooltip"]').tooltip();
        })
    }

