  <script is:inline></script> 
  <script is:inline>
    var PAGE_SIZE = 10;
    var submissionCodeSearch = "";
    var searchType = "";

    $('#btnSubmitKhac').on('click', function () {
        searchType = "CQTH";
        var cqId = 0;
        var isSuccess = true;
        var rdo = $("input[name='cap_thuc_hien']:checked").val();
        if (rdo == "bonganh") {
            $('#fmTraCuuHSKhac').data('bootstrapValidator').updateStatus('quan_huyen', 'VALID');
            $('#fmTraCuuHSKhac').data('bootstrapValidator').updateStatus('phuong_xa', 'VALID');
            $('#fmTraCuuHSKhac').data('bootstrapValidator').updateStatus('tinh_thanh', 'VALID');
            cqId = $('#cboCQ_BO_NGANHH').val() != -1 ? $('#cboCQ_BO_NGANHH').val() : $('#cboBO_NGANHH').val();
        } else {
            $('#fmTraCuuHSKhac').data('bootstrapValidator').updateStatus('bo_nganh', 'VALID');
            var rdoSo = $("input[name='quan_huyen_or_so']:checked").val();
            if (rdoSo == "so") {
                cqId = $('#cboSOO').val();
                $('#fmTraCuuHSKhac').data('bootstrapValidator').updateStatus('quan_huyen', 'VALID');
                $('#fmTraCuuHSKhac').data('bootstrapValidator').updateStatus('phuong_xa', 'VALID');
            } else {
                cqId = $('#cboQUAN_HUYENN').val();
                $('#fmTraCuuHSKhac').data('bootstrapValidator').updateStatus('so', 'VALID');
            }
        }
        $('#fmTraCuuHSKhac').data('bootstrapValidator').updateStatus('captchaCode', 'NOT_VALIDATED', 'notEmpty');

        $("#fmTraCuuHSKhac").data('bootstrapValidator').validate();
        if (cqId == -1) {
            isSuccess = false;
            $('#fmTraCuuHSKhac').data('bootstrapValidator').updateStatus('phuong_xa', 'INVALID');
        } else {
            isSuccess = true;
            $('#fmTraCuuHSKhac').data('bootstrapValidator').updateStatus('phuong_xa', 'VALID');
        }

        $("#tableBody").html("");
        $("#traCuuEmpty").html("");
        $("#btnThanhToan").html("");

        if ($("#fmTraCuuHSKhac").has('.has-error').length <= 0 && isSuccess) {
            $('#captchaCode').val("");
            submissionCodeSearch = getSubmissionCode(cqId);
            doSearch(1, submissionCodeSearch);
            $("#imgcaptcha").attr("src", "/jsp/imgcaptcha.jsp?" + (new Date()).getTime());
        }
    });

    $('#btnSubmitB').on('click', function () {
        searchType = "MHS";
        $("#fmTraCuuHSB").data('bootstrapValidator').validate();

        $("#tableBody").html("");
        $("#traCuuEmpty").html("");
        $("#btnThanhToan").html("");

        var dataResult = $('#captchaB small').attr("data-bv-result");
        var dataResultMaHSB = $('#maHSBParent small').attr("data-bv-result");
        if ($("#fmTraCuuHSB").has('.has-error').length <= 0 && dataResult == "VALID" && dataResultMaHSB == "VALID") {
            //changeCaptcha();
            submissionCodeSearch = $('#maHSB').val().trim();
            doSearch(1, submissionCodeSearch);
        } else {
            // $("#fmTraCuuHSB").data('bootstrapValidator').resetField("ipCatpchaB", true);
        }
    });

    function doSearch(currentPage, code) {
        var obj = new Object();
        obj.ma_ho_so = code;
        obj.record_per_page = PAGE_SIZE;
        obj.page_index = currentPage;
        obj.captCha = $("#ipCaptchaB").val();

        var total = 0;
        var result = [];
        $.ajax({
            type: 'POST',
            url: '/jsp/mongodb/submission/get-submission.jsp',
            data: obj,
            async: false,
            success: function (response) {
                if (response.TongSo > 0) {
                    result = response.HoSo;
                    total = parseInt(response.TongSo);
                    changeCaptcha();
                }
            },
            error: function (error) {
                changeCaptcha();
                console.log("Không thể kết nối tới server MongoDB");
            }
        });

        if (searchType == "CQTH" && $("input[name='cap_thuc_hien']:checked").val() == "bonganh") {
            var cqId = $('#cboBO_NGANHH').val();
            submissionCodeSearch = getSubmissionCode(cqId);
            if (code != submissionCodeSearch) {
                var result2 = searchBoNganh(currentPage, submissionCodeSearch);

                if (result2.HoSo && result2.HoSo.length > 0) {
                    total += parseInt(result2.TongSo);
                    result = result.concat(result2);
                }
            }
        }

        $("#traCuuEmpty").hide();
        $("#btnThanhToan").hide();
        $("#paginationCN").show();
        if (result && result.length > 0) {
            $("#tableSubmission").show();
            renderHTML(result, currentPage, total);
        } else {
            $("#tableSubmission").hide();
            $('#traCuuEmpty').html('<div class="text"><div class="title center" style="font-size: 18px;color: #545151;padding-top:20px">Không tìm thấy hồ sơ nào thoả mãn điều kiện tìm kiếm</div></div>');
            $('#traCuuEmpty').show();
            loadPagination(0, 0, "paginationCN", "doChangePage", result, PAGE_SIZE);
        }
    }

    function searchBoNganh(currentPage, code) {
        var obj = new Object();
        obj.ma_ho_so = code;
        obj.record_per_page = PAGE_SIZE;
        obj.page_index = currentPage;

        $.ajax({
            type: 'POST',
            url: '/jsp/mongodb/submission/get-submission.jsp',
            data: obj,
            async: false,
            success: function (response) {
                if (response.length > 0) {
                    return response;
                }
            },
            error: function (error) {
                console.log("Không thể kết nối tới server MongoDB");
            }
        });

        return new Object();
    }

    function getSubmissionCode(cqId) {
        console.log('cqId: ' + cqId);
        var obj = new Object();
        obj.service = 'dvcqg_get_agency_by_id_service';
        obj.type = "qry";
        obj.id = cqId;
        obj.provider = "dvcquocgiaRead";

        var result = apiservice.AjaxJson.executeQuery(obj);

        if (result && result.length > 0 && JSON.stringify(result) != "[null]" && result[0].ERROR_CODE != "") {
            return result[0].AGENCY_CODE + "-" + splitDate($('#sNgayNop').val()) + "-" + $('#maHS').val();
        }

        return "";
    }

    var hoSoTTId = "";
    function renderHTML(result, currentPage, total) {
        var tableBodyData = "";
        var session = '';

        for (var i = 0; i < result.length; i++) {
            var data = result[i];
            hoSoTTId = data._id.$oid;
            var statusClass = renderClassStatus(data.TrangThaiHoSo);
            var statusNameStr = getStatusNameFromId(data.TrangThaiHoSo);

            tableBodyData += '<tr>';
            tableBodyData += '<td>' + data.TenTTHC + '</td>';
            tableBodyData += '<td><span class="' + statusClass + '" style="margin-left: 0px">' + statusNameStr + '</span></td>';
            
            // if (session === "") {
            //     tableBodyData += '<td><a class="thick" href="javascript:showAlertView(1)">' + data.MaHoSo + '</a></td>';
            // } else if (session !== data.MaDoiTuong) {
            //     tableBodyData += '<td><a class="thick" href="javascript:showAlertView(2)">' + data.MaHoSo + '</a></td>';
            // } else {
            //     tableBodyData += '<td><a class="thick" href="javascript:viewDetail(\'' + data.MaHoSo + '\');">' + data.MaHoSo + '</a></td>';
            // }
            tableBodyData += '<td>' + data.MaHoSo + '</td>';

            if (data.DonViXuLy) {
                tableBodyData += '<td>' + data.DonViXuLy + '</td>';
            } else {
                tableBodyData += '<td>N/A</td>';
            }

            tableBodyData += '<td>' + getDateFromString(data.NgayTiepNhan) + '</td>';
            tableBodyData += '</tr>';

            var isKhaiBaoFee = checkLePhiKhaiBao(data.MaTTHC);

            if (data.STATUS != 10 && isKhaiBaoFee) {
                tableBodyData += '<tr><td colspan="5">';
                // tableBodyData += '<button class="btn btn-second" onclick="checkThongTinTT(\'' + data.MaHoSo + '\',\'' + data.MaTTHC + '\')"><span class="-ap icon icon-check3 main"></span>  Kiểm tra thông tin thanh toán</button>';
                tableBodyData += '<button class="btn btn-second" onclick="checkThongTinTT(\'' + data.MaHoSo + '\',\'' + data.MaTTHC + '\', \'' + data.TaiKhoanDongBo + '\')"><span class="-ap icon icon-check3 main"></span>  Kiểm tra thông tin thanh toán</button>';
                tableBodyData += '</td></tr>';
            }
        }

        $("#tableBody").html(tableBodyData);
        loadPagination(total, currentPage, "paginationCN", "doChangePage", result, PAGE_SIZE);
    }

    function getStatusNameFromId(statusId) {
        var obj = new Object();
        obj.service = 'dvc_get_status_name_by_id';
        obj.type = "qry";
        obj.id = statusId;

        var result = apiservice.AjaxJson.executeQuery(obj);

        if (result && result.length > 0 && JSON.stringify(result) != "[null]") {
            return validStr(result[0].STATUS_NAME);
        }

        return "N/A";
    }

    function getDateFromString(dateStr, isTimeShow) {
        // Dateformat 2013-03-10T02:00:00Z

        if (validStr(dateStr) && validStr(dateStr.$date)) {
            var date = new Date(dateStr.$date);
            if (!isTimeShow) {
                return getNumberLessTen(date.getDate()) + '/' + getNumberLessTen(date.getMonth() + 1) + '/' + date.getFullYear();
            } else {
                return getNumberLessTen(date.getDate()) + '/' + getNumberLessTen(date.getMonth() + 1) + '/' + date.getFullYear() + ' ' + getNumberLessTen(date.getHours()) + ':' + getNumberLessTen(date.getMinutes()) + ':' + getNumberLessTen(date.getSeconds());
            }
        }

        return "N/A";
    }

    function getNumberLessTen(number) {
        if (number < 10) {
            return "0" + number;
        }

        return number;
    }

