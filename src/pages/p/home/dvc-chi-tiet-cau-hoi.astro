<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Chi tiết câu hỏi - Cổng Dịch vụ công Quốc gia</title>
<script is:inline>
(function() {
  var urlParams = new URLSearchParams(window.location.search);
  var id = urlParams.get('id');
  if (id) {
    window.location.replace("dvc-chi-tiet-cau-hoi.html@id=" + encodeURIComponent(id) + "&row_limit=1.html");
  } else {
    window.location.replace("dvc-cau-hoi-pho-bien.html");
  }
})();
</script>
</head>
<body>
<p>Đang chuyển hướng đến chi tiết câu hỏi...</p>
</body>
</html>
