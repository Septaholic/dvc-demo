---
// login.do.astro - Authentication Endpoint ported from xacthuc.dichvucong.gov.vn
---
<!doctype html>
<html>
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="icon" href="/authenticationendpoint/images/quoc_huy.ico" type="image/x-icon"/>
    <link href="/authenticationendpoint/libs/themes/default/theme.min.css" rel="stylesheet">
    <title>Cổng Dịch vụ công Quốc gia</title>

    <script is:inline src="/authenticationendpoint/libs/jquery_3.4.1/jquery-3.4.1.js"></script>
    <link href="/authenticationendpoint/css/custom-common.css" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="/authenticationendpoint/css/style.css">
    <link href="/authenticationendpoint/fonts/Roboto.css" rel="stylesheet">
    <link href="/authenticationendpoint/fonts/NunitoSans.css" rel="stylesheet">
    <link href="/authenticationendpoint/fonts/Lora.css" rel="stylesheet">
    <script is:inline src="/authenticationendpoint/js/config.js"></script>
</head>
<body class="login-portal layout authentication-portal-layout"
      style="background-color:#FBFBFB; font-family: Nunito Sans !important; width:100%; min-height: 850px;">
<main class="center-segment" style="margin-top:20px">
    <div class="ui container medium center aligned middle aligned" style="max-width: 660px !important;">

        <div class="">
            <div class="d-flex justify-content-center" id="logoHeader" style="margin-bottom:30px">
                <div class="col text-center mt-2 flex-column">
                    <a href="/p/home/dvc-trang-chu.html" id="imgHeader">
                        <img src="/authenticationendpoint/images/quoc_huy.svg" alt="Quốc huy" height="60" width="60">
                    </a>
                    <div class="d-flex justify-content-center" style="margin:0 auto">
                        <img src="/authenticationendpoint/images/GroupTextHeader.svg" alt="Cổng Dịch vụ công Quốc gia">
                    </div>
                </div>
            </div>
        </div>

        <div class="ui segment">
            <div class="ui header">
                <div class="text-center">
                    <h4
                            style="color: #333333;font-weight: bold; font-family: Nunito Sans !important;margin-bottom: 20px;font-size: 30px;
                                line-height: 24px;
                                font-weight: 600;">
                        Đăng nhập</h4>
                </div>
            </div>

            <div class="segment-form">
                <div class="field">
                    <div class="grid-container" style="max-width: 570px; margin: 0 auto; display: flex !important; justify-content: center; gap: 20px;">
                        <div class="login-card login-IDP BCA" style="flex: 1; padding: 25px 15px; border-radius: 8px; border: 1px solid #ddd; background: #fff; cursor: pointer; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.05); transition: all 0.2s;" onclick="performFakeLogin()">
                            <div style="margin-bottom: 12px;">
                                <img src="/authenticationendpoint/images/quoc_huy.svg" width="48" height="48" alt="VNeID" />
                            </div>
                            <div style="font-size: 15px; font-weight: bold; color: #333; margin-bottom: 6px; min-height: 44px; line-height: 1.4;">
                                Tài khoản Định danh điện tử cấp bởi Bộ Công an
                            </div>
                            <div style="font-size: 13px; color: #777; margin-bottom: 18px; min-height: 38px; line-height: 1.4;">
                                Dành cho Cán bộ, Công chức, Viên chức và Công dân
                            </div>
                            <button type="button" class="btn-Login" style="width: 100%; font-size: 16px; cursor: pointer;">Đăng nhập</button>
                        </div>
                        <div class="login-card login-IDP DVCQG" style="flex: 1; padding: 25px 15px; border-radius: 8px; border: 1px solid #ddd; background: #fff; cursor: pointer; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.05); transition: all 0.2s;" onclick="performFakeLogin()">
                            <div style="margin-bottom: 12px;">
                                <img src="/authenticationendpoint/images/quoc_huy.svg" width="48" height="48" alt="DVCQG" />
                            </div>
                            <div style="font-size: 15px; font-weight: bold; color: #333; margin-bottom: 6px; min-height: 44px; line-height: 1.4;">
                                Tài khoản cấp bởi Cổng DVC Quốc gia
                            </div>
                            <div style="font-size: 13px; color: #777; margin-bottom: 18px; min-height: 38px; line-height: 1.4;">
                                Dành cho Công dân, Doanh nghiệp
                            </div>
                            <button type="button" class="btn-Login-2" style="width: 100%; font-size: 16px; cursor: pointer;">Đăng nhập</button>
                        </div>
                    </div>
                </div>
                
                <div class="field" style="background-color: antiquewhite;padding: 30px;border-radius: 5px; margin: 10px">
                    <em class="text-uppercase" style="font-weight: bold">Thông báo từ hệ thống:</em>
                    <p>Khi đăng nhập các thông tin cá nhân (Họ và tên, ngày sinh, giới tính, số điện thoại,...) được đồng bộ từ VNeID sang Cổng Dịch vụ công Quốc gia để phục vụ giải quyết TTHC</p>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- footer -->
<footer class="footer" id="sticky-footer" style="background-color:#913938;color: #fff;width:100%; margin-left:0px; padding:10px;">
    <div class="row text-white-200 fixed-bottom row d-flex justify-content-center" >
        <div class="footer-block"><h6 class="text-footer">Cơ quan chủ quản: Văn phòng Chính phủ</h6></div>
        <div class="footer-block"><h6 class="text-footer">www.dichvucong.gov.vn</h6></div>
        <div class="footer-block"><h6 class="text-footer">Tổng đài hỗ trợ: 18001096</h6></div>
        <div class="footer-block"><h6 class="text-footer">Email: dichvucong@chinhphu.vn</h6></div>
    </div>
</footer>

<script is:inline src="/authenticationendpoint/libs/themes/default/semantic.min.js"></script>

<script is:inline>
    function performFakeLogin() {
        var fakeUser = {
            name: 'Người dùng',
            username: 'nguoidung',
            total_finished: 0,
            total_processing: 0,
            loginTime: new Date().toISOString()
        };
        sessionStorage.setItem('dvc_user', JSON.stringify(fakeUser));
        window.location.href = '/p/home/dvc-trang-chu.html';
    }

    $(document).ready(function () {
        $('.login-card, .btn-Login, .btn-Login-2, .login-IDP').on('click', function (e) {
            e.preventDefault();
            performFakeLogin();
        });
    });
</script>
</body>
</html>
