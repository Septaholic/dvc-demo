			strTable += '<div class="title2">' + (data.TenTTHC || 'Không rõ thủ tục') + '</div>';
			strTable += '</div>'; // đóng title

			// Phần content-box
			strTable += '<div class="content-box">';

			// Phần info-content
			strTable += '<div class="info-content">';
			strTable += '<div class="item">';
			strTable += '<div class="shape"></div>';
			strTable += '<span class="key">Mã hồ sơ </span>';
			strTable += '<div class="value">' + data.MaHoSo + '</div>';
			strTable += '</div>'; // đóng item

			strTable += '<div class="item">';
			strTable += '<div class="shape"></div>';
			strTable += '<span class="key">Ngày trả </span>';
			strTable += '<div class="value">' + (NgayBoSung || 'Chưa có') + '</div>';
			strTable += '</div>'; // đóng item
			strTable += '</div>'; // đóng info-content

			// Phần nội dung
			strTable += '<div class="input">';
			strTable += '<div class="label-text">Nội dung</div>';
			strTable += '<div class="area">' + (NoiDungBoSung) + '</div>';
			strTable += '</div>'; // đóng input

			// Phần actions
			strTable += '<div class="actions">';
			strTable += '<div class="image">';
			if(data.TrangThaiHoSo == '6'){
				strTable += '<img src="img/congdan/2.jpg" alt="">';
			}else{
				strTable += '<img src="img/congdan/1.jpg" alt="">';
