            }
        });
    }


	function renderHTML(listData, currentPage, totalCnt) {
        var strTable = "";
        var data = new Object();
        var classStatus = "";
        var textViewResult = "";
		let start = (currentPage - 1) * itemsPerPage;
    	let end = Math.min(start + itemsPerPage, listData.length);
		console.log('end======',end);
		console.log('listData.length======',listData.length);
        for (var i = 0; i < listData.length; i++) {
            data = listData[i];
			console.log('data.TaiKhoanDongBo======',data.TaiKhoanDongBo);
			var agencyData = getAgencyInfoFromAgency(data.TaiKhoanDongBo);
			var agency_link = "";
			if(agencyData){
				try{
					agency_link = agencyData[0].API_GET_DATA_URL +data.MaHoSo;
