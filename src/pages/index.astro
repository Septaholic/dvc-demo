	function getParamQuery() {
        var obj = new Object();
        obj.service = 'crud_get_list_value_by_id';
        obj.type = "qry";
		obj.provider = "dvcquocgiaRead";
		obj.id = "9138350";
        var result = apiservice.AjaxJson.executeQuery(obj);
        return result;
    }

	


	function callSearch() {
		const key = 'lastCalledTime';
		const now = new Date().getTime();
		const lastCalled = localStorage.getItem(key);
		var value_show = getParamQuery();
		if(value_show && value_show[0].VALUE == '1'){
			if (!lastCalled) {
				doSearch(1);
				localStorage.setItem(key, now);
			} else {
				const elapsed = now - parseInt(lastCalled); // thời gian đã trôi qua
				const muoiPhut = 1 * 60 * 1000; // 10 phút tính bằng ms

				if (elapsed >= muoiPhut) {
				doSearch(1);
				localStorage.setItem(key, now);
				} else {
				console.log('Chưa đủ 10 phút, không gọi lại.');
				}
			}
		}
		
	}

	

