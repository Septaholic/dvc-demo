---
import Layout from '../layouts/Layout.astro';
import HeroBanner from '../components/HeroBanner.astro';
import FocusServicesSection from '../components/FocusServicesSection.astro';
import CitizenBusinessTabs from '../components/CitizenBusinessTabs.astro';
---

<Layout title="Cổng Dịch vụ công Quốc gia - Astro Port" activeNav="home">
  <!-- Hero banner & Search -->
  <HeroBanner />

  <!-- 13 Core services requested -->
  <FocusServicesSection />

  <!-- Citizen & Business Life Event Groups -->
  <CitizenBusinessTabs />

  <!-- Quick Guide Banner -->
  <section style="background: #e2e8f0; padding: 30px 0; border-top: 1px solid #cbd5e1;">
    <div class="container text-center">
      <div style="max-width: 800px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px;">
        <div class="text-left">
          <h4 style="margin: 0 0 5px 0; font-weight: 700; color: #0b5796;">
            <i class="fa fa-book" style="margin-right: 8px;"></i>Tài liệu hướng dẫn 13 dịch vụ công
          </h4>
          <p style="margin: 0; color: #64748b; font-size: 14px;">
            Xem chi tiết bảng phân loại, cách điều hướng và mã thủ tục hành chính.
          </p>
        </div>
        <a 
          href="/HUONG_DAN_DICH_VU.md" 
          target="_blank" 
          class="btn btn-primary" 
          style="background: #0b5796; border: none; font-weight: 600; padding: 10px 22px; border-radius: 6px;"
        >
          <i class="fa fa-external-link" style="margin-right: 6px;"></i> Đọc hướng dẫn (Markdown)
        </a>
      </div>
    </div>
  </section>
</Layout>
