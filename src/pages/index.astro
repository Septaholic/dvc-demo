					console.log('don vi chua cau hinh link chi tiet======');
				}
			}
			console.log(agency_link);
			var recivedDate = data.NgayTiepNhan ? data.NgayTiepNhan : "";
			var NoiDungBoSung = '';
			var NgayBoSung = '';
			if(data.DanhSachHoSoBoSung !== undefined && data.DanhSachHoSoBoSung.length > 0){
				NoiDungBoSung = data.DanhSachHoSoBoSung[data.DanhSachHoSoBoSung.length - 1].NoiDungBoSung;
				NgayBoSung = getDateFromString(data.DanhSachHoSoBoSung[data.DanhSachHoSoBoSung.length - 1].NgayBoSung);
			}
			// console.log('data.NoiDungBoSung======',data.DanhSachHoSoBoSung[data.DanhSachHoSoBoSung.length - 1].NoiDungBoSung);

			strTable += '<div class="box-notification">';

			// Phần title
			strTable += '<div class="title">';
