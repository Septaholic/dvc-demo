	function doSearch(currentPage) {
        var obj = new Object();
        var keyword = '';
        obj.keyword = $.trim(keyword);
        obj.ma_ho_so = '';
        obj.status = "3,5,6";
        obj.record_per_page = "100";
        obj.page_index = currentPage;

        $('#tableListDVC').html('');
        showLoading();
        $.ajax({
            type: 'POST',
            url: '/jsp/mongodb/submission/get-list_trangchu.jsp',
            data: obj,
            success: function (response) {
                hideLoading();
                console.log(response);
                if (response.HoSo && response.HoSo.length > 0) {
                    $('#dichVuCong').hide();
                    $('#dichVuCong').html('');
					renderHTML(response.HoSo, currentPage, response.TongSo);
					setTimeout(showPopupNcovi, 2000);
                    // renderTabHTML(response.HoSo, currentPage, response.TongSo);
                } else {
                    $('#dichVuCong').html('<div class="text"><div class="center" style="font-size:18px;color: rgb(206, 122, 88);">Không tìm thấy hồ sơ nào thoả mãn điều kiện tìm kiếm</div></div>');
                    $('#dichVuCong').show();
                    // loadPagination(0, 0, "paginationCN", "doChangePageCN", null, PAGE_SIZE);
                }
            },
            error: function (error) {
                hideLoading();
                $('#dichVuCong').html('<div class="text"><div class="center" style="font-size:18px;color: rgb(206, 122, 88);">Không tìm thấy hồ sơ nào thoả mãn điều kiện tìm kiếm</div></div>');
