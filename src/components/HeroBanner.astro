<div class="hero-banner-section" style="background: linear-gradient(135deg, #0b5796 0%, #1e3a8a 100%); color: #fff; padding: 45px 0 55px 0; position: relative;">
  <div class="container">
    <div class="row text-center" style="margin-bottom: 25px;">
      <div class="col-xs-12">
        <h1 style="font-size: 32px; font-weight: 800; text-transform: uppercase; margin-bottom: 10px; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.2);">
          CỔNG DỊCH VỤ CÔNG QUỐC GIA
        </h1>
        <p style="font-size: 16px; opacity: 0.9; max-width: 800px; margin: 0 auto;">
          Nền tảng tích hợp, chia sẻ dữ liệu phục vụ giải quyết thủ tục hành chính và cung cấp dịch vụ công trực tuyến toàn quốc
        </p>
      </div>
    </div>

    <!-- Search box -->
    <div class="row" style="margin-bottom: 35px;">
      <div class="col-md-8 col-md-offset-2 col-xs-12">
        <div class="search-box-wrap" style="background: #fff; border-radius: 50px; padding: 6px 10px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); display: flex; align-items: center;">
          <input 
            type="text" 
            id="globalSearchInput" 
            placeholder="Nhập tên thủ tục hành chính, từ khóa tìm kiếm (Ví dụ: Hộ chiếu, Kết hôn, Xây dựng...)" 
            style="border: none; outline: none; padding: 10px 18px; width: 100%; font-size: 15px; color: #1e293b; background: transparent;"
            onkeypress="if(event.key === 'Enter') handleSearch();"
          />
          <button 
            type="button" 
            onclick="handleSearch()" 
            style="background: #a82218; color: #fff; border: none; border-radius: 50px; padding: 12px 28px; font-weight: 600; font-size: 15px; cursor: pointer; display: flex; align-items: center; gap: 8px; flex-shrink: 0;"
          >
            <i class="fa fa-search"></i> Tìm kiếm
          </button>
        </div>
      </div>
    </div>

    <!-- 4 Action Cards -->
    <div class="row">
      <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 15px;">
        <a href="/p/home/dvc-tthc-thu-tuc-hanh-chinh.html" style="text-decoration: none; color: inherit;">
          <div style="background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; padding: 20px; text-align: center; transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.22)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'">
            <div style="font-size: 28px; margin-bottom: 10px; color: #f59e0b;"><i class="fa fa-laptop"></i></div>
            <strong style="display: block; font-size: 15px; text-transform: uppercase;">Dịch vụ công trực tuyến</strong>
            <small style="opacity: 0.8; font-size: 12px;">Nộp hồ sơ trực tuyến toàn trình</small>
          </div>
        </a>
      </div>

      <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 15px;">
        <a href="javascript:void(0)" onclick="toastr.info('Vui lòng nhập mã hồ sơ của bạn vào ô tìm kiếm hoặc chọn tra cứu hồ sơ.')" style="text-decoration: none; color: inherit;">
          <div style="background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; padding: 20px; text-align: center; transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.22)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'">
            <div style="font-size: 28px; margin-bottom: 10px; color: #38bdf8;"><i class="fa fa-search"></i></div>
            <strong style="display: block; font-size: 15px; text-transform: uppercase;">Tra cứu hồ sơ</strong>
            <small style="opacity: 0.8; font-size: 12px;">Theo dõi tiến độ xử lý hồ sơ</small>
          </div>
        </a>
      </div>

      <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 15px;">
        <a href="/p/home/dvc-tthc-thu-tuc-hanh-chinh.html" style="text-decoration: none; color: inherit;">
          <div style="background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; padding: 20px; text-align: center; transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.22)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'">
            <div style="font-size: 28px; margin-bottom: 10px; color: #4ade80;"><i class="fa fa-file-text-o"></i></div>
            <strong style="display: block; font-size: 15px; text-transform: uppercase;">Quyết định công bố</strong>
            <small style="opacity: 0.8; font-size: 12px;">Danh mục TTHC chuẩn quốc gia</small>
          </div>
        </a>
      </div>

      <div class="col-md-3 col-sm-6 col-xs-12" style="margin-bottom: 15px;">
        <a href="/HUONG_DAN_DICH_VU.md" target="_blank" style="text-decoration: none; color: inherit;">
          <div style="background: rgba(255,255,255,0.12); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; padding: 20px; text-align: center; transition: all 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.22)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'">
            <div style="font-size: 28px; margin-bottom: 10px; color: #f43f5e;"><i class="fa fa-book"></i></div>
            <strong style="display: block; font-size: 15px; text-transform: uppercase;">Hướng dẫn sử dụng</strong>
            <small style="opacity: 0.8; font-size: 12px;">Xem tài liệu hướng dẫn 13 dịch vụ</small>
          </div>
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function handleSearch() {
    var val = document.getElementById('globalSearchInput').value.trim();
    if (!val) {
      toastr.warning('Vui lòng nhập từ khóa cần tìm kiếm.');
      return;
    }
    window.location.href = '/p/home/dvc-tthc-thu-tuc-hanh-chinh.html?tu_khoa=' + encodeURIComponent(val);
  }
</script>
