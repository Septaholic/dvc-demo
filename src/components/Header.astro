---
interface Props {
  activeNav?: string;
}

const { activeNav = 'home' } = Astro.props;
---

<header class="site-header">
  <!-- Top bar -->
  <div class="header-top-bar" style="background: #a82218; color: #fff; padding: 6px 0; font-size: 13px;">
    <div class="container">
      <div class="row" style="display: flex; align-items: center; justify-content: space-between;">
        <div class="col-sm-6 col-xs-12">
          <span><i class="fa fa-phone" style="margin-right: 5px;"></i>Tổng đài hỗ trợ: <strong>1800 1096</strong> (Miễn phí)</span>
        </div>
        <div class="col-sm-6 col-xs-12 text-right">
          <a href="/p/home/dvc-cau-hoi-pho-bien.html" style="color: #fff; margin-right: 15px;"><i class="fa fa-question-circle"></i> Trợ giúp</a>
          <a href="javascript:void(0)" onclick="toastr.info('Cổng DVCQG hỗ trợ đăng nhập qua tài khoản VNeID.')" style="color: #fff; margin-right: 15px;"><i class="fa fa-user"></i> Đăng nhập</a>
          <a href="javascript:void(0)" onclick="toastr.info('Vui lòng sử dụng ứng dụng định danh điện tử VNeID để đăng ký tài khoản.')" style="color: #fff;"><i class="fa fa-pencil-square-o"></i> Đăng ký</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main header banner -->
  <div class="header-main" style="background: #ffffff; padding: 18px 0; border-bottom: 2px solid #e2e8f0;">
    <div class="container">
      <div class="row" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
        <div class="col-md-7 col-sm-8 col-xs-12" style="display: flex; align-items: center;">
          <a href="/" style="display: flex; align-items: center; text-decoration: none;">
            <img src="/img/header/quoc_huy.png" alt="Quốc huy Việt Nam" style="height: 68px; width: auto; margin-right: 15px;" onerror="this.src='/p/home/img/header/quoc_huy.png'" />
            <div>
              <div style="color: #a82218; font-size: 22px; font-weight: 800; letter-spacing: 0.5px; text-transform: uppercase; line-height: 1.2;">
                CỔNG DỊCH VỤ CÔNG QUỐC GIA
              </div>
              <div style="color: #64748b; font-size: 13px; font-weight: 500; margin-top: 3px;">
                Kết nối, cung cấp thông tin và dịch vụ công trực tuyến
              </div>
            </div>
          </a>
        </div>

        <div class="col-md-5 col-sm-4 col-xs-12 text-right" style="margin-top: 10px;">
          <div style="display: inline-flex; align-items: center; gap: 8px;">
            <span class="badge" style="background-color: #0b5796; padding: 8px 12px; font-size: 13px; font-weight: 600;">
              <i class="fa fa-check-circle" style="margin-right: 4px;"></i> Astro v7 Powered
            </span>
            <span class="badge" style="background-color: #f59e0b; padding: 8px 12px; font-size: 13px; font-weight: 600; color: #fff;">
              <i class="fa fa-bolt" style="margin-right: 4px;"></i> 13 Dịch vụ trọng tâm
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Navigation bar -->
  <nav class="navbar navbar-default" style="background: #0b5796; border-radius: 0; margin-bottom: 0; border: none;">
    <div class="container">
      <div class="navbar-header">
        <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#main-navbar" aria-expanded="false" style="border-color: #fff;">
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar" style="background-color: #fff;"></span>
          <span class="icon-bar" style="background-color: #fff;"></span>
          <span class="icon-bar" style="background-color: #fff;"></span>
        </button>
      </div>

      <div class="collapse navbar-collapse" id="main-navbar" style="padding-left: 0; padding-right: 0;">
        <ul class="nav navbar-nav">
          <li class={activeNav === 'home' ? 'active' : ''}>
            <a href="/" style="color: #fff; font-weight: 600; padding: 14px 18px; text-transform: uppercase;"><i class="fa fa-home"></i> Trang chủ</a>
          </li>
          <li class={activeNav === 'tthc' ? 'active' : ''}>
            <a href="/p/home/dvc-tthc-thu-tuc-hanh-chinh.html" style="color: #fff; font-weight: 600; padding: 14px 18px; text-transform: uppercase;">Thủ tục hành chính</a>
          </li>
          <li class={activeNav === 'services' ? 'active' : ''}>
            <a href="/#dich-vu-trong-tam" style="color: #fff; font-weight: 600; padding: 14px 18px; text-transform: uppercase; background-color: rgba(255,255,255,0.12);">13 Dịch vụ trọng tâm</a>
          </li>
          <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false" style="color: #fff; font-weight: 600; padding: 14px 18px; text-transform: uppercase;">
              Công dân <span class="caret"></span>
            </a>
            <ul class="dropdown-menu">
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-cong-dan.html@group=753.html">Cư trú và giấy tờ tùy thân</a></li>
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-cong-dan.html@group=754.html">Hôn nhân và gia đình</a></li>
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-cong-dan.html@group=752.html">Việc làm và lao động</a></li>
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-cong-dan.html@group=755.html">Điện lực, nhà ở, đất đai</a></li>
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-cong-dan.html@group=757.html">Phương tiện và người lái</a></li>
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-cong-dan.html@group=758.html">Hưu trí và bảo trợ xã hội</a></li>
            </ul>
          </li>
          <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false" style="color: #fff; font-weight: 600; padding: 14px 18px; text-transform: uppercase;">
              Doanh nghiệp <span class="caret"></span>
            </a>
            <ul class="dropdown-menu">
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-doanh-nghiep.html@group=760.html">Khởi sự kinh doanh</a></li>
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-doanh-nghiep.html@group=763.html">Đất đai, xây dựng</a></li>
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-doanh-nghiep.html@group=764.html">Thương mại, quảng cáo</a></li>
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-doanh-nghiep.html@group=765.html">Sở hữu trí tuệ, tài sản</a></li>
              <li><a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-doanh-nghiep.html@group=762.html">Thuế và hóa đơn</a></li>
            </ul>
          </li>
          <li class={activeNav === 'faq' ? 'active' : ''}>
            <a href="/p/home/dvc-cau-hoi-pho-bien.html" style="color: #fff; font-weight: 600; padding: 14px 18px; text-transform: uppercase;">Hỏi đáp</a>
          </li>
          <li>
            <a href="/p/phananhkiennghi/pakn-tra-cuu.html" style="color: #fff; font-weight: 600; padding: 14px 18px; text-transform: uppercase;">Phản ánh kiến nghị</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
