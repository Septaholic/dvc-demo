<section id="dich-vu-trong-tam" class="focus-services-section" style="padding: 55px 0; background: #f8fafc;">
  <div class="container">
    <div class="section-header text-center" style="margin-bottom: 35px;">
      <span class="badge" style="background: #a82218; color: #fff; padding: 6px 14px; font-size: 13px; font-weight: 600; text-transform: uppercase; margin-bottom: 10px;">
        Nhiệm vụ trọng tâm
      </span>
      <h2 style="font-size: 28px; font-weight: 800; color: #0b5796; text-transform: uppercase; margin: 10px 0;">
        <i class="fa fa-star" style="color: #f59e0b; margin-right: 8px;"></i>13 Dịch Vụ Công Trực Tuyến Trọng Tâm
      </h2>
      <p style="color: #64748b; font-size: 15px; max-width: 750px; margin: 0 auto;">
        Toàn bộ 13 dịch vụ từ 2 ảnh yêu cầu đã được cấu hình, tối ưu hóa giao diện và liên kết trực tiếp để thực hiện nộp hồ sơ trực tuyến thuận tiện nhất.
      </p>
    </div>

    <div class="row">
      {services.map((item) => (
        <div class="col-md-4 col-sm-6 col-xs-12" style="margin-bottom: 25px;">
          <div class="service-card" style="background: #fff; border-radius: 10px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.06); padding: 22px; height: 100%; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 10px 15px -3px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 6px -1px rgba(0,0,0,0.06)';">
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
                <span class="badge" style={`background-color: ${item.badgeColor}; color: #fff; padding: 4px 10px; font-size: 12px; font-weight: 600;`}>
                  {item.category}
                </span>
                <span style="font-size: 12px; color: #64748b; font-weight: 500;">
                  Mã: {item.code}
                </span>
              </div>

              <div style="display: flex; gap: 12px; margin-bottom: 12px;">
                <div style="width: 44px; height: 44px; border-radius: 8px; background: rgba(11,87,150,0.08); display: flex; align-items: center; justify-content: center; font-size: 20px; color: #0b5796; flex-shrink: 0;">
                  <i class={`fa ${item.icon}`}></i>
                </div>
                <div>
                  <h3 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 5px 0; line-height: 1.4;">
                    <a href={item.url} style="color: inherit; text-decoration: none;">
                      {item.title}
                    </a>
                  </h3>
                  <div style="font-size: 12px; color: #64748b;">
                    <i class="fa fa-folder-open-o" style="margin-right: 4px;"></i>{item.groupName}
                  </div>
                </div>
              </div>

              <p style="font-size: 13px; color: #475569; line-height: 1.5; margin-bottom: 18px;">
                {item.desc}
              </p>
            </div>

            <div style="display: flex; gap: 8px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
              <a 
                href={item.url} 
                class="btn btn-sm" 
                style="flex: 1; background: #0b5796; color: #fff; font-weight: 600; border-radius: 6px; text-align: center; padding: 7px 12px;"
              >
                <i class="fa fa-file-text-o" style="margin-right: 5px;"></i>Xem thủ tục
              </a>
              <a 
                href={`/p/home/dvc-chi-tiet-nhom-su-kien-cho-${item.category.includes('Doanh nghiệp') && !item.category.includes('Công dân') ? 'doanh-nghiep' : 'cong-dan'}.html@group=${item.groupId}.html`} 
                class="btn btn-sm btn-default" 
                style="background: #f1f5f9; color: #334155; font-weight: 600; border: 1px solid #e2e8f0; border-radius: 6px; padding: 7px 12px;"
                title="Xem theo nhóm sự kiện"
              >
                <i class="fa fa-list"></i> Sự kiện
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
