---
interface EventGroup {
  id: number;
  name: string;
  icon: string;
  type: 'cong-dan' | 'doanh-nghiep';
}

const congDanGroups: EventGroup[] = [
  { id: 753, name: "Cư trú và giấy tờ tùy thân", icon: "fa-address-card-o", type: 'cong-dan' },
  { id: 754, name: "Hôn nhân và gia đình", icon: "fa-heart", type: 'cong-dan' },
  { id: 752, name: "Việc làm và lao động", icon: "fa-briefcase", type: 'cong-dan' },
  { id: 755, name: "Điện lực, nhà ở, đất đai", icon: "fa-home", type: 'cong-dan' },
  { id: 757, name: "Phương tiện và người lái", icon: "fa-car", type: 'cong-dan' },
  { id: 756, name: "Sức khỏe và y tế", icon: "fa-medkit", type: 'cong-dan' },
  { id: 758, name: "Hưu trí và bảo trợ xã hội", icon: "fa-users", type: 'cong-dan' },
  { id: 750, name: "Khai sinh và trẻ em", icon: "fa-child", type: 'cong-dan' },
  { id: 751, name: "Giáo dục và đào tạo", icon: "fa-graduation-cap", type: 'cong-dan' },
  { id: 759, name: "Khai tử và mai táng", icon: "fa-file-text-o", type: 'cong-dan' },
  { id: 771, name: "Giải quyết khiếu nại, tố cáo", icon: "fa-balance-scale", type: 'cong-dan' }
];

const doanhNghiepGroups: EventGroup[] = [
  { id: 760, name: "Khởi sự kinh doanh", icon: "fa-rocket", type: 'doanh-nghiep' },
  { id: 763, name: "Đất đai, xây dựng", icon: "fa-building-o", type: 'doanh-nghiep' },
  { id: 764, name: "Thương mại, quảng cáo", icon: "fa-shopping-cart", type: 'doanh-nghiep' },
  { id: 765, name: "Sở hữu trí tuệ, tài sản", icon: "fa-copyright", type: 'doanh-nghiep' },
  { id: 762, name: "Thuế và hóa đơn", icon: "fa-calculator", type: 'doanh-nghiep' },
  { id: 761, name: "Lao động và bảo hiểm", icon: "fa-users", type: 'doanh-nghiep' },
  { id: 767, name: "Đấu thầu và mua sắm công", icon: "fa-gavel", type: 'doanh-nghiep' },
  { id: 766, name: "Chi nhánh, văn phòng đại diện", icon: "fa-sitemap", type: 'doanh-nghiep' },
  { id: 768, name: "Tái cơ cấu doanh nghiệp", icon: "fa-refresh", type: 'doanh-nghiep' },
  { id: 769, name: "Tạm dừng, giải thể", icon: "fa-power-off", type: 'doanh-nghiep' },
  { id: 791, name: "Giải quyết tranh chấp hợp đồng", icon: "fa-handshake-o", type: 'doanh-nghiep' }
];
---

<section class="target-group-section" style="padding: 50px 0; background: #ffffff;">
  <div class="container">
    <div class="row">
      <!-- CÔNG DÂN -->
      <div class="col-md-6 col-xs-12" style="margin-bottom: 30px;">
        <div style="background: #fff; border-radius: 12px; border: 2px solid #0b5796; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden;">
          <div style="background: #0b5796; color: #fff; padding: 18px 24px; display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <i class="fa fa-user" style="font-size: 24px;"></i>
              <h2 style="margin: 0; font-size: 20px; font-weight: 800; text-transform: uppercase; color: #fff;">
                DÀNH CHO CÔNG DÂN
              </h2>
            </div>
            <a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-cong-dan.html@group=753.html" style="color: #fff; font-size: 13px; text-decoration: underline;">
              Xem tất cả <i class="fa fa-angle-right"></i>
            </a>
          </div>

          <div style="padding: 20px;">
            <div class="row">
              {congDanGroups.map((g) => (
                <div class="col-sm-6 col-xs-12" style="margin-bottom: 12px;">
                  <a 
                    href={`/p/home/dvc-chi-tiet-nhom-su-kien-cho-cong-dan.html@group=${g.id}.html`}
                    style="display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; text-decoration: none; color: #1e293b; transition: all 0.2s;"
                    onmouseover="this.style.background='#eff6ff'; this.style.borderColor='#93c5fd';"
                    onmouseout="this.style.background='#f8fafc'; this.style.borderColor='#e2e8f0';"
                  >
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0;">
                      <i class={`fa ${g.icon}`}></i>
                    </div>
                    <span style="font-size: 13px; font-weight: 600; line-height: 1.3;">
                      {g.name}
                    </span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- DOANH NGHIỆP -->
      <div class="col-md-6 col-xs-12" style="margin-bottom: 30px;">
        <div style="background: #fff; border-radius: 12px; border: 2px solid #b45309; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); overflow: hidden;">
          <div style="background: #b45309; color: #fff; padding: 18px 24px; display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <i class="fa fa-building" style="font-size: 24px;"></i>
              <h2 style="margin: 0; font-size: 20px; font-weight: 800; text-transform: uppercase; color: #fff;">
                DÀNH CHO DOANH NGHIỆP
              </h2>
            </div>
            <a href="/p/home/dvc-chi-tiet-nhom-su-kien-cho-doanh-nghiep.html@group=760.html" style="color: #fff; font-size: 13px; text-decoration: underline;">
              Xem tất cả <i class="fa fa-angle-right"></i>
            </a>
          </div>

          <div style="padding: 20px;">
            <div class="row">
              {doanhNghiepGroups.map((g) => (
                <div class="col-sm-6 col-xs-12" style="margin-bottom: 12px;">
                  <a 
                    href={`/p/home/dvc-chi-tiet-nhom-su-kien-cho-doanh-nghiep.html@group=${g.id}.html`}
                    style="display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: #fffbeb; border: 1px solid #fef3c7; border-radius: 6px; text-decoration: none; color: #1e293b; transition: all 0.2s;"
                    onmouseover="this.style.background='#fef3c7'; this.style.borderColor='#fde68a';"
                    onmouseout="this.style.background='#fffbeb'; this.style.borderColor='#fef3c7';"
                  >
                    <div style="width: 32px; height: 32px; border-radius: 50%; background: #fed7aa; color: #ea580c; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0;">
                      <i class={`fa ${g.icon}`}></i>
                    </div>
                    <span style="font-size: 13px; font-weight: 600; line-height: 1.3;">
                      {g.name}
                    </span>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
